@model InvoiceParser.Web.Controllers.RuleEditViewModel
@{
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Extraction Rule" : "Edit Rule";
    int carrierId = (int)ViewBag.CarrierId;
    string carrierName = ViewBag.CarrierName ?? "Carrier";
}

<style>
    .rule-preview-box {
        background: #f0f7ff;
        border: 1px solid #b8d4f0;
        border-radius: 8px;
        padding: 14px 18px;
        font-size: .95rem;
        line-height: 1.6;
        min-height: 48px;
    }
    .rule-preview-box .highlight { font-weight: 600; color: #0d6efd; }
    .condition-sentence { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .condition-sentence select, .condition-sentence input {
        display: inline-block;
        width: auto !important;
        min-width: 120px;
    }
    .condition-sentence .join-word {
        font-weight: 600;
        color: #495057;
        white-space: nowrap;
    }
    .transform-card {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 10px 14px;
        margin-bottom: 8px;
    }
    .transform-card .step-num {
        width: 24px; height: 24px;
        background: #6c757d; color: #fff;
        border-radius: 50%; display: inline-flex;
        align-items: center; justify-content: center;
        font-size: .78rem; font-weight: 700;
        flex-shrink: 0;
    }
    .section-header {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6c757d;
        margin-bottom: 4px;
    }
    .field-group-header {
        font-weight: 600;
        color: #343a40;
        padding: 4px 0 2px;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .step-badge { display: inline-flex; align-items: center; gap: 6px; }
    .step-circle {
        width: 28px; height: 28px;
        background: #0d6efd; color: #fff;
        border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: .78rem; font-weight: 700;
        flex-shrink: 0;
    }
    .pattern-hint {
        font-size: .8rem;
        color: #6c757d;
    }
    .special-field-note {
        border-left: 3px solid #fd7e14;
        background: #fff8f0;
        padding: 8px 12px;
        border-radius: 0 4px 4px 0;
        font-size: .85rem;
    }
    /* Invoice line picker (Edit page) */
    .edit-line-pick {
        padding: 5px 10px; cursor: pointer; font-size: .8rem;
        font-family: monospace; border-bottom: 1px solid #eee;
        transition: background .1s;
    }
    .edit-line-pick:hover   { background: #e7f1ff; }
    .edit-line-pick.selected { background: #0d6efd; color: #fff; }
</style>

<div class="row justify-content-center">
<div class="col-lg-9">

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Carriers">Carriers</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-carrierId="@carrierId">@carrierName</a></li>
        <li class="breadcrumb-item active">@(isNew ? "New Rule" : "Edit Rule")</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex align-items-center gap-2">
        <i class="bi bi-sliders2"></i>
        <h5 class="mb-0">@(isNew ? "Create a New Rule" : "Edit Rule")</h5>
    </div>
    <div class="card-body">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    { <li>@e.ErrorMessage</li> }
                </ul>
            </div>
        }

            <!-- Hidden inputs for model binding — driven by JS -->
        <form asp-action="Save" method="post" id="ruleForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CarrierId" />
            <input type="hidden" asp-for="CarrierName" />
            <input type="hidden" asp-for="FieldName"              id="FieldName" />
            <input type="hidden" asp-for="TargetTable"            id="TargetTable" />
            <input type="hidden" asp-for="FieldType"              id="FieldType" />
            <input type="hidden" asp-for="ConditionSource"        id="ConditionSource" />
            <input type="hidden" asp-for="ConditionType"          id="ConditionType" />
            <input type="hidden" asp-for="RegexPattern"           id="RegexPattern" />
            <input type="hidden" asp-for="SortOrder"              id="SortOrder" value="@Model.SortOrder" />
            <input type="hidden" asp-for="IsActive"               id="IsActive" value="true" />
            <input type="hidden" asp-for="TransformationsJson"    id="TransformationsJson" />
            <input type="hidden" asp-for="DescriptionLineOffset"  id="DescriptionLineOffset" value="@Model.DescriptionLineOffset" />
            <input type="hidden" asp-for="AmountPattern"          id="AmountPattern" value="@(Model.AmountPattern ?? "")" />

            <!-- ══════════════════════════════════════════════════════════════
                 STEP 1 — What are you capturing?
            ══════════════════════════════════════════════════════════════ -->
            <div class="mb-4">
                <div class="step-badge mb-1">
                    <span class="step-circle">1</span>
                    <span class="fw-semibold fs-6">What information are you capturing?</span>
                </div>
                <p class="text-muted small mb-2 ps-1">
                    Choose the invoice field this rule extracts — for example, the invoice number, a charge description, or the total due.
                </p>

                <select id="friendlyFieldPicker" class="form-select form-select-lg mb-2">
                    <option value="">— Select the field you want to capture —</option>
                </select>

                <div id="specialFieldNote" class="special-field-note" style="display:none;"></div>

                <!-- Line-before-price info panel — shown only when line_before_price type is selected -->
                <div id="lineBeforePriceInfo" class="mt-3 p-3 border border-primary rounded bg-light" style="display:none;">
                    <p class="fw-semibold mb-2 small text-primary">How this rule works</p>
                    <p class="small mb-2">
                        When a line matches your trigger condition (e.g. <em>contains</em> <code>RECURRING CHARGE</code>),
                        the system automatically scans <strong>upward</strong> to find the nearest line that looks like a
                        product name — skipping blank lines and any other price lines on the way.
                    </p>
                    <div class="p-2 bg-white border rounded small font-monospace mb-2" style="font-size:.78rem; line-height:1.9;">
                        AppDirect SmartSupport &nbsp;&nbsp;&nbsp; ← <span class="text-success fw-bold">captured as description</span><br>
                        Standard &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ← skipped automatically<br>
                        RECURRING CHARGE $0.00 &nbsp;&nbsp;&nbsp; ← <span class="text-primary fw-bold">trigger line — amount taken from here</span>
                    </div>
                    <p class="text-muted small mb-0">
                        No offset number required. Works even when the number of lines between the product name and the price varies.
                    </p>
                </div>

                <!-- Table-row extra settings — shown only when table_row type is selected -->
                <div id="tableRowSettings" class="mt-3 p-3 border rounded bg-light" style="display:none;">
                    <p class="fw-semibold mb-2 small">
                        Table Row Settings
                        <span class="text-muted fw-normal">— for invoices where the product name is on a different line than the price</span>
                    </p>

                    <div class="row g-3 align-items-start">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">
                                The product name is how many lines <em>above</em> the price line?
                            </label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="number" id="descOffsetInput" class="form-control form-control-sm"
                                       style="width:80px;" min="1" max="10"
                                       value="@(Model.DescriptionLineOffset < 0 ? -Model.DescriptionLineOffset : 1)" />
                                <span class="text-muted small">line(s) above</span>
                            </div>
                            <div class="form-text">
                                Example: if the invoice looks like this:
                                <pre class="mt-1 mb-0 p-2 bg-white border rounded small" style="font-size:.75rem;">AppDirect SmartSupport   ← description (2 lines above)
Standard                 ← sub-label  (1 line above)
RECURRING CHARGE  $0.00  ← trigger line (this line)</pre>
                                set this to <strong>2</strong>.
                            </div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">
                                How to find the amount on the price line
                            </label>
                            <select id="amountStrategySelect" class="form-select form-select-sm mb-2">
                                <option value="last">Use the last dollar amount on the line (recommended)</option>
                                <option value="custom">Use a custom pattern</option>
                            </select>
                            <div id="customAmountPatternDiv" style="display:none;">
                                <input type="text" id="customAmountInput" class="form-control form-control-sm font-monospace"
                                       placeholder="e.g. \$\s*([\d,.]+)\s*$"
                                       value="@(Model.AmountPattern ?? "")" />
                                <div class="form-text">Enter a regex with one capture group containing the amount.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 mt-3 p-2 bg-light rounded border">
                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" role="switch" id="isActiveToggle"
                               @(Model.IsActive ? "checked" : "") />
                        <label class="form-check-label fw-semibold" for="isActiveToggle">Rule is active</label>
                    </div>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <label class="text-muted small mb-0" for="sortOrderInput">Run order</label>
                        <input type="number" id="sortOrderInput" class="form-control form-control-sm"
                               style="width:70px;" value="@Model.SortOrder" min="1" />
                        <button type="button" class="btn btn-link btn-sm p-0 text-secondary"
                                tabindex="0"
                                data-bs-toggle="popover" data-bs-trigger="focus" data-bs-placement="left" data-bs-html="true"
                                data-bs-title="What is Run Order?"
                                data-bs-content="Controls which rule runs first when multiple rules could match the same invoice line.<br><br><strong>Lower number = runs first.</strong> Default is 10.<br><br>Example: a rule with order <strong>5</strong> runs before one with order <strong>10</strong>. If both match, the order-5 rule wins."
                                aria-label="Run order help">
                            <i class="bi bi-question-circle-fill"></i>
                        </button>
                    </div>
                </div>
            </div>

            <hr />

            <!-- ══════════════════════════════════════════════════════════════
                 STEP 2 — When should this rule activate?
            ══════════════════════════════════════════════════════════════ -->
            <div class="mb-4" id="conditionSection">
                <div class="step-badge mb-1">
                    <span class="step-circle">2</span>
                    <span class="fw-semibold fs-6">When should this rule activate?</span>
                </div>
                <p class="text-muted small mb-3 ps-1">
                    Tell the system which lines in the invoice this rule should apply to.
                    Pick a match type, then type the text to look for.
                </p>

                <div class="condition-sentence ps-1">
                    <span class="join-word">Activate when the</span>

                    <select id="friendlySourceSelect" class="form-select" style="width:auto;min-width:160px;"
                            title="What part of the invoice to look at">
                        <option value="line_text">line text (most common)</option>
                        <option value="amount">dollar amount</option>
                        <option value="field_value">previously extracted value</option>
                    </select>

                    <select id="friendlyCondTypeSelect" class="form-select" style="width:auto;min-width:210px;">
                        <option value="contains">contains</option>
                        <option value="starts_with">starts with</option>
                        <option value="ends_with">ends with</option>
                        <option value="equals">is exactly (full match)</option>
                        <option value="not_equals">is NOT exactly</option>
                        <option value="does_not_contain">does NOT contain</option>
                        <option value="is_empty">is empty</option>
                        <option value="is_not_empty">is not empty</option>
                        <option value="greater_than">is greater than (number)</option>
                        <option value="less_than">is less than (number)</option>
                        <option value="regex_match">uses a regex pattern — advanced ✦</option>
                    </select>

                    <input type="text" id="friendlyPatternInput" class="form-control"
                           style="min-width:220px; flex:1;"
                           placeholder="Type the text to look for…" />
                </div>

                <!-- When in regex mode, show the stored raw regex for reference -->
                <div id="rawRegexRef" class="mt-1 ps-1" style="display:none;">
                    <span class="text-muted" style="font-size:.78rem;">
                        <i class="bi bi-code-slash me-1"></i>Stored pattern:
                        <code id="rawRegexRefCode" class="text-secondary" style="font-size:.78rem;word-break:break-all;"></code>
                    </span>
                </div>

                <!-- Dynamic contextual hint based on selected condition type -->
                <div id="conditionHint" class="mt-2 px-1"></div>

                <div id="patternHelpArea" class="mt-1"></div>

                <!-- regex_match: pattern builder helper -->
                <div id="regexHelperPanel" class="mt-3 p-3 bg-light border rounded" style="display:none;">
                    <p class="mb-1 fw-semibold small">
                        <i class="bi bi-tools me-1 text-primary"></i>Pattern builder
                        <span class="fw-normal text-muted"> — fill the boxes below and click Generate</span>
                    </p>
                    <p class="text-muted small mb-2">
                        Type the text that appears <em>before</em> the value in the invoice line.
                        The system will build the pattern automatically — no regex knowledge needed.
                    </p>
                    <div class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <label class="form-label form-label-sm text-muted mb-1">Text BEFORE the value <span class="text-danger">*</span></label>
                            <input type="text" id="patternPrefixInput" class="form-control form-control-sm"
                                   placeholder="e.g. Invoice No:" />
                        </div>
                        <div class="col-md-2 text-center">
                            <div class="text-muted small fw-bold mt-3">→ <span class="badge bg-primary">value</span> →</div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label form-label-sm text-muted mb-1">Text AFTER the value (optional)</label>
                            <input type="text" id="patternSuffixInput" class="form-control form-control-sm"
                                   placeholder="Leave blank if not needed" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-2 flex-wrap align-items-center">
                        <button type="button" class="btn btn-sm btn-primary" id="buildPatternBtn">
                            <i class="bi bi-magic me-1"></i>Generate Pattern
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="buildPatternSkipBtn"
                                title="Same as Generate Pattern, but skips one variable word (e.g. a date) between the label and the value">
                            Generate with [skip]
                        </button>
                        <span class="text-muted small">
                            Use <strong>[skip]</strong> when a variable word (like a date) sits between your label and the value
                            — e.g. <code>TOTAL DUE BY 04/16/26 -$47.29</code>
                        </span>
                    </div>
                    <div id="generatedPatternPreview" class="mt-2 p-2 bg-white border rounded" style="display:none;">
                        <span class="text-muted small">Generated: </span>
                        <code id="generatedPatternCode" class="small text-primary"></code>
                    </div>
                </div>

                <!-- ── Invoice line / token picker ────────────────────────── -->
                <div class="mt-3 p-2 border rounded bg-white d-flex align-items-center gap-3 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="editPickerToggle">
                        <i class="bi bi-file-earmark-text me-1"></i>Pick from invoice
                    </button>
                    <span class="text-muted small">
                        <strong>Easiest way to build a pattern:</strong> open the invoice, click a line,
                        then click the exact word you want to capture — the pattern is built for you automatically.
                    </span>
                </div>
                <div id="editPickerPanel" class="mt-2 p-2 border rounded" style="display:none;background:#f8f9fa;">
                    <div id="editPickerLoading" class="text-muted small py-2 ps-1">⏳ Loading invoice lines…</div>
                    <div id="editPickerEmpty" class="alert alert-info py-2 mb-0 small" style="display:none;">
                        No invoice has been uploaded for this carrier yet.
                        Upload one via the <a asp-action="Wizard" asp-route-carrierId="@carrierId">Add Rule Wizard</a>
                        or the main Invoice Upload page to enable the line picker.
                    </div>
                    <div id="editPickerList" style="display:none;">
                        <div class="input-group input-group-sm mb-2" style="max-width:320px;">
                            <span class="input-group-text bg-white border-end-0">🔍</span>
                            <input type="text" id="editLineSearch" class="form-control border-start-0 ps-0"
                                   placeholder="Filter lines…" autocomplete="off" />
                        </div>
                        <div id="editPdfLinesList" class="border rounded"
                             style="max-height:240px;overflow-y:auto;background:#fff;"></div>
                    </div>
                    <div id="editTokenSection" class="mt-2 pt-2 border-top" style="display:none;">
                        <div class="small fw-semibold mb-1" id="editTokenTitle">
                            Click the word that is the <span class="text-primary">value</span> you want to capture:
                        </div>
                        <div id="editLineTokens" class="border rounded px-2 py-2 bg-white font-monospace"
                             style="font-size:0.82rem;line-height:2.2;word-break:break-all;"></div>
                        <div class="form-text mt-1" id="editTokenHint">
                            <strong>Click once</strong> to select a word.
                            <strong>Click a second word</strong> to extend the selection.
                        </div>
                        <div id="editPatternPreview" class="alert alert-info py-1 px-2 small mt-2" style="display:none;">
                            <strong>Pattern set to:</strong> <code id="editPatternPreviewCode"></code>
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <!-- ══════════════════════════════════════════════════════════════
                 STEP 3 — Clean up the value (optional transforms)
            ══════════════════════════════════════════════════════════════ -->
            <div class="mb-4" id="transformSection">
                <div class="step-badge mb-1">
                    <span class="step-circle">3</span>
                    <span class="fw-semibold fs-6">Clean up the captured value <span class="badge bg-secondary fw-normal ms-1" style="font-size:.7rem;vertical-align:middle;">Optional</span></span>
                </div>
                <p class="text-muted small mb-3 ps-1">
                    After the value is captured you can optionally transform it — for example,
                    remove trailing noise, reformat a date to <code>YYYY-MM-DD</code>, or trim spaces.
                    Skip this step if the captured value is already in the right format.
                </p>

                <div id="transformSteps" class="mb-3"></div>

                <button type="button" class="btn btn-outline-secondary btn-sm" id="addTransformStep">
                    + Add Cleanup Step
                </button>
            </div>

            <hr />

            <!-- ══════════════════════════════════════════════════════════════
                 LIVE PREVIEW
            ══════════════════════════════════════════════════════════════ -->
            <div class="mb-4">
                <div class="section-header d-flex align-items-center gap-1">
                    <i class="bi bi-eye"></i> Live Rule Summary
                    <span class="text-muted fw-normal" style="font-size:.72rem;text-transform:none;letter-spacing:0;">
                        — updates as you make changes above
                    </span>
                </div>
                <div class="rule-preview-box" id="rulePreviewBox">
                    <span class="text-muted">Select a field above to see a plain-English summary of this rule.</span>
                </div>
            </div>

            <hr />

            <!-- ══════════════════════════════════════════════════════════════
                 STEP 4 — Test your rule
            ══════════════════════════════════════════════════════════════ -->
            <div class="mb-4">
                <div class="step-badge mb-1">
                    <span class="step-circle">4</span>
                    <span class="fw-semibold fs-6">Test your rule against an invoice</span>
                </div>
                <p class="text-muted small mb-3 ps-1">
                    Run the rule against a real invoice to see which lines it matches and what value it extracts — before saving.
                </p>

                <div class="d-flex gap-3 align-items-center flex-wrap mb-2">
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="radio" name="textSource"
                               id="srcStored" value="stored" checked />
                        <label class="form-check-label" for="srcStored">
                            Use the last uploaded invoice for this carrier
                        </label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="radio" name="textSource"
                               id="srcManual" value="manual" />
                        <label class="form-check-label" for="srcManual">
                            Paste invoice text manually
                        </label>
                    </div>
                </div>

                <div id="manualTextPanel" style="display:none;" class="mb-2">
                    <textarea id="manualPdfText" class="form-control font-monospace"
                              rows="8"
                              placeholder="Paste invoice text here — copy lines from your PDF viewer or a text editor…"
                              style="font-size:.8rem;resize:vertical;"></textarea>
                </div>

                <button type="button" class="btn btn-outline-info" id="testRuleBtn">
                    ▶ Test Rule
                </button>

                <div id="testResult" class="mt-2" style="display:none;">
                    <div id="testResultContent"></div>
                </div>
            </div>

            <hr />

            <div class="d-flex gap-2 align-items-center p-3 bg-light rounded border mt-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Save Rule
                </button>
                <a asp-action="Index" asp-route-carrierId="@carrierId" class="btn btn-outline-secondary">
                    Cancel
                </a>
                <span class="text-muted small ms-2">Changes take effect immediately after saving.</span>
                @if (!isNew)
                {
                    <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-carrierId="@carrierId" method="post" class="ms-auto"
                          onsubmit="return confirm('Are you sure you want to delete this rule? This action cannot be undone.')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1"></i>Delete Rule
                        </button>
                    </form>
                }
            </div>

        </form>
    </div>
</div>

</div><!-- col -->
</div><!-- row -->

@section Scripts {
<script>
(function () {
    // ── Data from server ──────────────────────────────────────────────────────
    var FIELD_OPTIONS  = @Html.Raw(ViewBag.FieldOptionsJson  ?? "[]");
    var TRANSFORM_TYPES = @Html.Raw(ViewBag.TransformTypesJson ?? "[]");

    // Current model values (for pre-populating when editing)
    var modelFieldName   = @Html.Raw(Json.Serialize(Model.FieldName ?? ""));
    var modelTargetTable = @Html.Raw(Json.Serialize(Model.TargetTable ?? "t_invoice"));
    var modelFieldType   = @Html.Raw(Json.Serialize(Model.FieldType ?? "string"));
    var modelCondSrc     = @Html.Raw(Json.Serialize(Model.ConditionSource ?? "line_text"));
    var modelCondType    = @Html.Raw(Json.Serialize(Model.ConditionType ?? "contains"));
    var modelPattern     = @Html.Raw(Json.Serialize(Model.RegexPattern ?? ""));
    var modelTransJson   = @Html.Raw(Json.Serialize(Model.TransformationsJson ?? ""));

    var carrierId = @carrierId;

    // ── Build grouped friendly picker ─────────────────────────────────────────
    var picker = document.getElementById('friendlyFieldPicker');
    FIELD_OPTIONS.forEach(function (grp) {
        var og = document.createElement('optgroup');
        og.label = grp.group;
        grp.fields.forEach(function (f) {
            var opt = document.createElement('option');
            opt.value = f.value;   // "fieldname|table|type"
            opt.textContent = f.label;
            og.appendChild(opt);
        });
        picker.appendChild(og);
    });

    // Pre-select current field when editing
    if (modelFieldName) {
        for (var i = 0; i < picker.options.length; i++) {
            var parts = (picker.options[i].value || '').split('|');
            if (parts[0] === modelFieldName && parts[1] === modelTargetTable) {
                picker.value = picker.options[i].value;
                break;
            }
        }
    }

    var SPECIAL_NOTES = {
        'section_start': 'This is a <strong>Section Marker</strong>. When a line matches this rule, the system starts collecting charge lines from that point.',
        'section_end':   'This is a <strong>Section End Marker</strong>. When a line matches this rule, the system stops collecting charge lines.',
        'skip':          'This is a <strong>Skip Rule</strong>. Any charge line that matches will be ignored and not saved.',
        'table_row':          'This is a <strong>Table Row Rule</strong>. When a price line is found, the system looks <em>above it</em> to find the product name. Use the settings below to tell it how many lines above the product name appears.',
        'line_before_price':  'This is a <strong>Line Before Price</strong> rule. When a price line is matched, the system automatically scans upward to find the nearest product name — no offset needed.'
    };

    picker.addEventListener('change', function () {
        applyFieldSelection(this.value);
        updatePreview();
    });

    function applyFieldSelection(val) {
        if (!val) return;
        var parts = val.split('|');
        var field = parts[0], table = parts[1], ftype = parts[2];
        document.getElementById('FieldName').value   = field;
        document.getElementById('TargetTable').value = table;
        document.getElementById('FieldType').value   = ftype;

        var note = document.getElementById('specialFieldNote');
        if (SPECIAL_NOTES[ftype]) {
            note.innerHTML = '<i class="bi bi-info-circle me-1"></i>' + SPECIAL_NOTES[ftype];
            note.style.display = '';
        } else {
            note.style.display = 'none';
        }

        // Show / hide table-row settings panel
        document.getElementById('tableRowSettings').style.display      = (ftype === 'table_row')          ? '' : 'none';
        document.getElementById('lineBeforePriceInfo').style.display   = (ftype === 'line_before_price')   ? '' : 'none';

        // For section/skip/table_row rules, condition source is always line_text
        if (ftype === 'section_start' || ftype === 'section_end' || ftype === 'skip' || ftype === 'table_row') {
            document.getElementById('friendlySourceSelect').value = 'line_text';
        }
    }

    // ── Table-row settings wiring ─────────────────────────────────────────────
    function syncTableRowHiddens() {
        var offset = parseInt(document.getElementById('descOffsetInput').value) || 1;
        document.getElementById('DescriptionLineOffset').value = -Math.abs(offset);

        var strategy = document.getElementById('amountStrategySelect').value;
        var customPat = document.getElementById('customAmountInput').value.trim();
        document.getElementById('AmountPattern').value = (strategy === 'custom' && customPat) ? customPat : '';
    }

    document.getElementById('descOffsetInput').addEventListener('input', function () { syncTableRowHiddens(); updatePreview(); });

    document.getElementById('amountStrategySelect').addEventListener('change', function () {
        document.getElementById('customAmountPatternDiv').style.display = (this.value === 'custom') ? '' : 'none';
        syncTableRowHiddens();
    });

    document.getElementById('customAmountInput').addEventListener('input', syncTableRowHiddens);

    // Pre-populate table-row settings from model values
    (function initTableRowSettings() {
        var existingOffset = @Model.DescriptionLineOffset;
        if (existingOffset < 0) document.getElementById('descOffsetInput').value = Math.abs(existingOffset);
        var existingAmt = @Html.Raw(Json.Serialize(Model.AmountPattern ?? ""));
        if (existingAmt) {
            document.getElementById('amountStrategySelect').value = 'custom';
            document.getElementById('customAmountPatternDiv').style.display = '';
            document.getElementById('customAmountInput').value = existingAmt;
        }
        syncTableRowHiddens();
    })();

    // Apply initial selection
    applyFieldSelection(picker.value);

    // ── Active toggle & sort order ─────────────────────────────────────────────
    document.getElementById('isActiveToggle').addEventListener('change', function () {
        document.getElementById('IsActive').value = this.checked ? 'true' : 'false';
    });
    document.getElementById('sortOrderInput').addEventListener('input', function () {
        document.getElementById('SortOrder').value = this.value;
    });

    // ── Steps must be declared here so updatePreview() can safely read steps.length
    // even on the very first call (before the transform section is initialised below).
    var steps = [];
    if (modelTransJson) {
        try { steps = JSON.parse(modelTransJson) || []; } catch(e) { steps = []; }
    }

    // ── Condition builder ─────────────────────────────────────────────────────
    var srcSelect  = document.getElementById('friendlySourceSelect');
    var ctSelect   = document.getElementById('friendlyCondTypeSelect');
    var patInput   = document.getElementById('friendlyPatternInput');
    var helpArea   = document.getElementById('patternHelpArea');
    var regexPanel = document.getElementById('regexHelperPanel');
    var condHint   = document.getElementById('conditionHint');

    // When this flag is true, patInput is showing a human-readable representation
    // of the raw regex (which lives in the hidden #RegexPattern field).
    // syncConditionHiddens will NOT overwrite the hidden field in that case.
    // Cleared the moment the user types directly into patInput.
    var _patReadableMode = false;

    // Pre-populate condition
    srcSelect.value = modelCondSrc  || 'line_text';
    ctSelect.value  = modelCondType || 'contains';

    // For regex_match: show the friendly representation in the visible input
    // while the raw pattern stays in the hidden RegexPattern field (already set by the model).
    if (modelCondType === 'regex_match' && modelPattern) {
        var _initialReadable = toReadable(modelPattern);
        patInput.value      = _initialReadable || modelPattern;
        _patReadableMode    = !!_initialReadable;
    } else {
        patInput.value = modelPattern || '';
    }

    function syncConditionHiddens() {
        document.getElementById('ConditionSource').value = srcSelect.value;
        document.getElementById('ConditionType').value   = ctSelect.value;
        // Only copy patInput → RegexPattern when NOT in readable-display mode.
        // (In readable mode the raw regex is already in the hidden field.)
        if (!_patReadableMode) {
            document.getElementById('RegexPattern').value = patInput.value;
        }
    }
    syncConditionHiddens();

    // ── Per-condition hint messages ───────────────────────────────────────────
    var COND_HINTS = {
        'contains':          '<i class="bi bi-info-circle text-primary me-1"></i>Matches any invoice line where this text appears <strong>anywhere</strong> — e.g. type <code>Invoice No:</code> to match lines containing that label.',
        'starts_with':       '<i class="bi bi-info-circle text-primary me-1"></i>Matches lines that <strong>begin</strong> with this text exactly — useful when the label is always at the start of the line (e.g. <code>Bill#</code>).',
        'ends_with':         '<i class="bi bi-info-circle text-primary me-1"></i>Matches lines that <strong>end</strong> with this text — useful when a line always finishes with a known word or code.',
        'equals':            '<i class="bi bi-info-circle text-primary me-1"></i>The entire line must match <strong>exactly</strong> — every character must be identical (case-insensitive). Rarely used.',
        'not_equals':        '<i class="bi bi-info-circle text-primary me-1"></i>Matches lines that are <strong>not</strong> this exact text.',
        'does_not_contain':  '<i class="bi bi-info-circle text-primary me-1"></i>Matches any line that <strong>does not</strong> include this text — useful for filtering out unwanted lines.',
        'is_empty':          '<i class="bi bi-info-circle text-primary me-1"></i>Matches when the field has <strong>no value</strong>. No text needed.',
        'is_not_empty':      '<i class="bi bi-info-circle text-primary me-1"></i>Matches when the field has <strong>any value</strong>. No text needed.',
        'greater_than':      '<i class="bi bi-info-circle text-primary me-1"></i>Matches when the numeric amount is <strong>larger</strong> than the number you enter.',
        'less_than':         '<i class="bi bi-info-circle text-primary me-1"></i>Matches when the numeric amount is <strong>smaller</strong> than the number you enter.',
        'regex_match':       '<i class="bi bi-stars text-warning me-1"></i><strong>Advanced — Regex Pattern.</strong> A regular expression (regex) lets you describe a flexible rule for matching text. <em>If you\'re not familiar with regex, use the pattern builder below instead of typing one manually.</em>'
    };

    // Converts a raw regex pattern to a human-readable description (mirrors server-side ReadablePattern)
    function toReadable(pat) {
        if (!pat) return '';
        // Replace capturing groups (...) with [value]
        var r = pat.replace(/\((?!\?)[^)]+\)/g, '[value]');
        r = r.replace(/\\s\+/g, ' ').replace(/\\s\*/g, ' ')
             .replace(/\\S\+/g, '[skip]').replace(/\\S\*/g, '[skip]')
             .replace(/\\d\+/g, '#').replace(/\\d\*/g, '#')
             .replace(/\\\./g, '.').replace(/\\\(/g, '(').replace(/\\\)/g, ')')
             .replace(/\\\-/g, '-').replace(/\(\?:/g, '').replace(/\(\?i:/g, '')
             .replace(/\(\?/g, '').replace(/\^/g, '').replace(/\$/g, '')
             .replace(/\.\?/g, '…').replace(/\.\*/g, '…').replace(/\.\+/g, '…')
             .replace(/\s+/g, ' ').trim();
        return r.length > 80 ? r.substring(0, 77) + '…' : r;
    }

    function updateConditionUI() {
        var ct = ctSelect.value;
        regexPanel.style.display = (ct === 'regex_match') ? '' : 'none';

        // Dynamic hint
        condHint.innerHTML = COND_HINTS[ct]
            ? '<p class="text-muted small mb-0">' + COND_HINTS[ct] + '</p>'
            : '';

        if (ct === 'is_empty' || ct === 'is_not_empty') {
            patInput.style.display = 'none';
            helpArea.innerHTML = '';
            _patReadableMode = false;
        } else if (ct === 'regex_match') {
            patInput.style.display = '';
            patInput.placeholder = 'Use the builder or picker below — or type a raw regex pattern';
            helpArea.innerHTML = '';
            // When switching to regex_match, show the readable version of whatever
            // is currently stored in the hidden RegexPattern field.
            var _rawNow = document.getElementById('RegexPattern').value;
            if (_rawNow) {
                var _readNow = toReadable(_rawNow);
                if (_readNow && _readNow !== _rawNow) {
                    patInput.value   = _readNow;
                    _patReadableMode = true;
                }
            }
        } else {
            patInput.style.display = '';
            patInput.placeholder = 'Type the text to look for in the invoice line…';
            helpArea.innerHTML = '';
            _patReadableMode = false;
        }

        syncConditionHiddens();
        updateRegexReadable();
        updatePreview();
    }

    // patInput now shows the human-readable version directly (see _patReadableMode flag).
    // The raw regex lives in the hidden #RegexPattern field.
    // Show/hide the "Stored pattern: <code>" reference line beneath the input.
    function updateRegexReadable() {
        var ct  = ctSelect.value;
        var raw = document.getElementById('RegexPattern').value;
        var refDiv  = document.getElementById('rawRegexRef');
        var refCode = document.getElementById('rawRegexRefCode');
        if (ct === 'regex_match' && raw && _patReadableMode) {
            refCode.textContent = raw;
            refDiv.style.display = '';
        } else {
            refDiv.style.display = 'none';
        }
    }

    ctSelect.addEventListener('change', function () { updateConditionUI(); });
    srcSelect.addEventListener('change', function () { syncConditionHiddens(); updatePreview(); });
    patInput.addEventListener('input', function () {
        _patReadableMode = false;
        syncConditionHiddens();
        updateRegexReadable();
        updatePreview();
    });

    updateConditionUI();

    // ── Regex pattern builder ─────────────────────────────────────────────────
    function escPat(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    function applyBuiltPattern(rawPat) {
        var readable = toReadable(rawPat);
        patInput.value = readable || rawPat;
        document.getElementById('RegexPattern').value = rawPat;
        _patReadableMode = !!(readable && readable !== rawPat);
        document.getElementById('generatedPatternCode').textContent = rawPat;
        document.getElementById('generatedPatternPreview').style.display = '';
        syncConditionHiddens();
        updateRegexReadable();
        updatePreview();
    }

    document.getElementById('buildPatternBtn').addEventListener('click', function () {
        var pre  = document.getElementById('patternPrefixInput').value.trim();
        var suf  = document.getElementById('patternSuffixInput').value.trim();
        var pat  = '';
        if (pre) pat += escPat(pre) + '\\s*';
        pat += '([\\d.,\\s\\w/-]+?)';
        if (suf) pat += '\\s*' + escPat(suf);
        applyBuiltPattern(pat);
    });

    document.getElementById('buildPatternSkipBtn').addEventListener('click', function () {
        var pre  = document.getElementById('patternPrefixInput').value.trim();
        var suf  = document.getElementById('patternSuffixInput').value.trim();
        var pat  = '';
        if (pre) pat += escPat(pre) + '\\s+';
        pat += '\\S+\\s+';
        pat += '\\$?\\s*';
        pat += '([\\-\\d,]+\\.\\d{2})';
        if (suf) pat += '\\s*' + escPat(suf);
        applyBuiltPattern(pat);
    });

    // ── Transform steps ───────────────────────────────────────────────────────
    // (steps is already initialised above the condition-builder section)

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function renderSteps() {
        var container = document.getElementById('transformSteps');
        container.innerHTML = '';
        if (steps.length === 0) {
            container.innerHTML = '<p class="text-muted small">No cleanup steps added — the value will be used exactly as captured.</p>';
            syncTransHidden();
            return;
        }
        steps.forEach(function (step, idx) {
            var meta = TRANSFORM_TYPES.find(function(t){ return t.value === step.Type; }) || { label: step.Type, hasV1: false, hasV2: false, v1label: 'Value', v2label: 'Value 2' };
            var html = '<div class="transform-card d-flex align-items-start gap-2" data-idx="' + idx + '">'
                + '<span class="step-num mt-1">' + (idx + 1) + '</span>'
                + '<div class="flex-grow-1">'
                + '<select class="form-select form-select-sm step-type mb-2" data-idx="' + idx + '" style="max-width:320px;">';
            TRANSFORM_TYPES.forEach(function (tt) {
                html += '<option value="' + tt.value + '"' + (tt.value === step.Type ? ' selected' : '') + '>' + tt.label + '</option>';
            });
            html += '</select>';
            if (meta.hasV1) {
                html += '<input type="text" class="form-control form-control-sm step-v1 mb-1" data-idx="' + idx + '"'
                    + ' placeholder="' + escHtml(meta.v1label || 'Value') + '"'
                    + ' value="' + escHtml(step.Value1 || '') + '" />';
            }
            if (meta.hasV2) {
                html += '<input type="text" class="form-control form-control-sm step-v2" data-idx="' + idx + '"'
                    + ' placeholder="' + escHtml(meta.v2label || 'Value 2') + '"'
                    + ' value="' + escHtml(step.Value2 || '') + '" />';
            }
            html += '</div>'
                + '<button type="button" class="btn btn-sm btn-outline-danger step-remove mt-1" data-idx="' + idx + '" title="Remove this step">×</button>'
                + '</div>';
            container.insertAdjacentHTML('beforeend', html);
        });
        syncTransHidden();
    }

    function syncTransHidden() {
        document.getElementById('TransformationsJson').value = steps.length > 0 ? JSON.stringify(steps) : '';
        updatePreview();
    }

    document.getElementById('transformSteps').addEventListener('change', function (e) {
        var idx = parseInt(e.target.getAttribute('data-idx'));
        if (isNaN(idx)) return;
        if (e.target.classList.contains('step-type')) { steps[idx].Type = e.target.value; renderSteps(); }
        if (e.target.classList.contains('step-v1'))   { steps[idx].Value1 = e.target.value; syncTransHidden(); }
        if (e.target.classList.contains('step-v2'))   { steps[idx].Value2 = e.target.value; syncTransHidden(); }
    });
    document.getElementById('transformSteps').addEventListener('input', function (e) {
        var idx = parseInt(e.target.getAttribute('data-idx'));
        if (isNaN(idx)) return;
        if (e.target.classList.contains('step-v1')) { steps[idx].Value1 = e.target.value; syncTransHidden(); }
        if (e.target.classList.contains('step-v2')) { steps[idx].Value2 = e.target.value; syncTransHidden(); }
    });
    document.getElementById('transformSteps').addEventListener('click', function (e) {
        if (e.target.classList.contains('step-remove')) {
            steps.splice(parseInt(e.target.getAttribute('data-idx')), 1);
            renderSteps();
        }
    });
    document.getElementById('addTransformStep').addEventListener('click', function () {
        steps.push({ Type: 'trim', Value1: null, Value2: null });
        renderSteps();
    });

    renderSteps();

    // ── Live rule preview ─────────────────────────────────────────────────────
    function updatePreview() {
        var box = document.getElementById('rulePreviewBox');

        var selVal    = picker.value;
        var fieldLabel = '';
        for (var i = 0; i < picker.options.length; i++) {
            if (picker.options[i].value === selVal) { fieldLabel = picker.options[i].textContent; break; }
        }
        if (!fieldLabel) {
            box.innerHTML = '<span class="text-muted">Select a field above to see a preview of this rule.</span>';
            return;
        }

        var ftype = (selVal.split('|')[2] || '');
        var src   = srcSelect.options[srcSelect.selectedIndex]?.textContent || srcSelect.value;
        var ct    = ctSelect.value;
        var ctLabel = ctSelect.options[ctSelect.selectedIndex]?.textContent || ct;
        var pat   = patInput.value.trim();

        var html = '';

        // Special types
        if (ftype === 'section_start') {
            html = 'When a line ' + condPhrase(ct, ctLabel, pat) + ', the system will <span class="highlight">start collecting charge lines</span> from that point.';
        } else if (ftype === 'section_end') {
            html = 'When a line ' + condPhrase(ct, ctLabel, pat) + ', the system will <span class="highlight">stop collecting charge lines</span>.';
        } else if (ftype === 'skip') {
            html = 'Any charge line that ' + condPhrase(ct, ctLabel, pat) + ' will be <span class="highlight">ignored</span> and not saved.';
        } else if (ftype === 'table_row') {
            var offset = Math.abs(parseInt(document.getElementById('descOffsetInput').value) || 1);
            html = 'When a price line ' + condPhrase(ct, ctLabel, pat)
                + ', the system will capture the <span class="highlight">product name</span> from <strong>'
                + offset + ' line' + (offset !== 1 ? 's' : '') + ' above</strong> it as the charge description'
                + ', and the <span class="highlight">last dollar amount</span> on the price line as the charge amount.';
        } else if (ftype === 'line_before_price') {
            html = 'When a price line ' + condPhrase(ct, ctLabel, pat)
                + ', the system will <span class="highlight">automatically find the nearest product name</span>'
                + ' above it and use it as the charge description.'
                + ' The <span class="highlight">last dollar amount</span> on the price line becomes the charge amount.';
        } else {
            html = 'Capture <span class="highlight">' + escHtml(fieldLabel) + '</span> from any line whose ' + src + ' ' + condPhrase(ct, ctLabel, pat) + '.';
        }

        if (steps.length > 0) {
            var stepLabels = steps.map(function (s) {
                var m = TRANSFORM_TYPES.find(function(t){ return t.value === s.Type; });
                var lbl = m ? m.label : s.Type;
                if (s.Value1) lbl += ' <em>"' + escHtml(s.Value1) + '"</em>';
                if (s.Value2) lbl += ' → <em>"' + escHtml(s.Value2) + '"</em>';
                return lbl;
            });
            html += '<br/><span class="text-secondary small">Then: ' + stepLabels.join(' → ') + '</span>';
        }

        box.innerHTML = html;
    }

    function condPhrase(ct, ctLabel, pat) {
        if (ct === 'is_empty')     return 'is <strong>empty</strong>';
        if (ct === 'is_not_empty') return 'is <strong>not empty</strong>';
        if (!pat) return '<strong>' + escHtml(ctLabel) + '</strong> <em class="text-muted">(no value set)</em>';
        return '<strong>' + escHtml(ctLabel) + '</strong> <code>' + escHtml(pat) + '</code>';
    }

    // ── Text source toggle ────────────────────────────────────────────────────
    document.getElementById('srcStored').addEventListener('change', function () {
        document.getElementById('manualTextPanel').style.display = 'none';
    });
    document.getElementById('srcManual').addEventListener('change', function () {
        document.getElementById('manualTextPanel').style.display = '';
    });

    // ── Test rule ─────────────────────────────────────────────────────────────
    document.getElementById('testRuleBtn').addEventListener('click', function () {
        var btn = this;
        var isManual  = document.getElementById('srcManual').checked;
        var manualTxt = document.getElementById('manualPdfText').value.trim();

        if (isManual && !manualTxt) {
            document.getElementById('testResultContent').innerHTML =
                '<div class="alert alert-warning mb-0">Please paste some invoice text into the box above before testing.</div>';
            document.getElementById('testResult').style.display = '';
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Testing…';

        fetch('/CarrierRules/Test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                carrierId:           carrierId,
                conditionType:       document.getElementById('ConditionType').value,
                conditionSource:     document.getElementById('ConditionSource').value,
                regexPattern:        document.getElementById('RegexPattern').value,
                transformationsJson: document.getElementById('TransformationsJson').value || null,
                pdfText:             isManual ? manualTxt : null
            })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            var box = document.getElementById('testResult');
            box.style.display = '';
            if (data.success) {
                document.getElementById('testResultContent').innerHTML =
                    '<div class="alert alert-success mb-0">'
                    + '<strong>✓ ' + data.count + ' match' + (data.count !== 1 ? 'es' : '') + ' found:</strong>'
                    + '<ul class="mb-0 mt-1">'
                    + data.matches.map(function (m) { return '<li><code>' + escHtml(m) + '</code></li>'; }).join('')
                    + '</ul></div>';
            } else {
                document.getElementById('testResultContent').innerHTML =
                    '<div class="alert alert-warning mb-0">' + escHtml(data.message) + '</div>';
            }
        })
        .catch(function (err) {
            document.getElementById('testResultContent').innerHTML =
                '<div class="alert alert-danger mb-0">Request failed: ' + escHtml(String(err)) + '</div>';
            document.getElementById('testResult').style.display = '';
        })
        .finally(function () {
            btn.disabled = false;
            btn.textContent = '▶ Test Rule';
        });
    });

    // ── Invoice line / token picker ───────────────────────────────────────────
    (function () {
        var editLines       = [];
        var editLinesLoaded = false;
        var editPendingStart = -1;

        var toggleBtn      = document.getElementById('editPickerToggle');
        var panel          = document.getElementById('editPickerPanel');
        var loadingEl      = document.getElementById('editPickerLoading');
        var emptyEl        = document.getElementById('editPickerEmpty');
        var listWrap       = document.getElementById('editPickerList');
        var linesList      = document.getElementById('editPdfLinesList');
        var tokenSec       = document.getElementById('editTokenSection');
        var tokenTitle     = document.getElementById('editTokenTitle');
        var tokenHint      = document.getElementById('editTokenHint');
        var tokenCont      = document.getElementById('editLineTokens');
        var previewDiv     = document.getElementById('editPatternPreview');
        var previewCode    = document.getElementById('editPatternPreviewCode');

        // Toggle open / close
        toggleBtn.addEventListener('click', function () {
            var open = panel.style.display !== 'none';
            panel.style.display = open ? 'none' : '';
            toggleBtn.innerHTML = open
                ? '<i class="bi bi-file-earmark-text me-1"></i>Pick from invoice'
                : '<i class="bi bi-chevron-up me-1"></i>Hide invoice picker';
            if (!open && !editLinesLoaded) loadLines();
        });

        function loadLines() {
            loadingEl.style.display = '';
            emptyEl.style.display   = 'none';
            listWrap.style.display  = 'none';

            fetch('/CarrierRules/PdfLines/' + carrierId)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                loadingEl.style.display = 'none';
                editLinesLoaded = true;
                editLines = data.lines || [];
                if (editLines.length === 0) { emptyEl.style.display = ''; return; }
                renderLines();
                listWrap.style.display = '';
            })
            .catch(function () {
                loadingEl.style.display = 'none';
                emptyEl.style.display   = '';
            });
        }

        function renderLines() {
            linesList.innerHTML = '';
            editLines.forEach(function (line, idx) {
                var div = document.createElement('div');
                div.className = 'edit-line-pick';
                div.setAttribute('data-text', line.toLowerCase());
                div.textContent = line;
                div.addEventListener('click', function () {
                    linesList.querySelectorAll('.edit-line-pick').forEach(function (el) { el.classList.remove('selected'); });
                    div.classList.add('selected');
                    editPendingStart = -1;
                    renderTokenPicker(line);
                });
                linesList.appendChild(div);
            });

            document.getElementById('editLineSearch').addEventListener('input', function () {
                var term = this.value.trim().toLowerCase();
                linesList.querySelectorAll('.edit-line-pick').forEach(function (el) {
                    el.style.display = (term && !el.getAttribute('data-text').includes(term)) ? 'none' : '';
                });
            });
        }

        function renderTokenPicker(line) {
            var ct = ctSelect.value;
            var ft = document.getElementById('FieldType').value || 'string';
            var isRegex = (ct === 'regex_match');

            if (isRegex) {
                tokenTitle.innerHTML = 'Click the word that is the <span class="text-primary fw-bold">value</span> to capture:';
            } else {
                tokenTitle.innerHTML = 'Click the word(s) that <span class="text-warning fw-bold">identify</span> this line — fills the match pattern:';
            }
            tokenHint.innerHTML = '<strong>Click once</strong> to select a word. <strong>Click a second word</strong> to extend.';

            tokenCont.innerHTML = '';
            previewDiv.style.display = 'none';
            editPendingStart = -1;

            var tokens = line.trim().split(/\s+/);
            if (tokens.length === 0) { tokenSec.style.display = 'none'; return; }

            tokens.forEach(function (tok, idx) {
                var span = document.createElement('span');
                span.textContent = tok;
                span.className   = 'badge border me-1 mb-1';
                span.style.cssText = 'cursor:pointer;font-size:0.82rem;font-weight:400;background:#fff;color:#333;transition:background .1s;';

                span.addEventListener('mouseenter', function () {
                    if (span.dataset.selected) return;
                    if (editPendingStart !== -1 && idx !== editPendingStart) {
                        var f = Math.min(editPendingStart, idx), t2 = Math.max(editPendingStart, idx);
                        tokenCont.querySelectorAll('span').forEach(function (s, si) {
                            if (si >= f && si <= t2) s.style.background = '#cfe2ff';
                        });
                    } else { span.style.background = '#e7f0ff'; }
                });
                span.addEventListener('mouseleave', function () {
                    tokenCont.querySelectorAll('span').forEach(function (s) {
                        if (!s.dataset.selected) s.style.background = '#fff';
                    });
                    tokenCont.querySelectorAll('span[data-selected]').forEach(function (s) {
                        s.style.background = '#0d6efd'; s.style.color = '#fff';
                    });
                    if (editPendingStart !== -1) {
                        var ps = tokenCont.querySelectorAll('span')[editPendingStart];
                        if (ps) { ps.style.background = '#0d6efd'; ps.style.color = '#fff'; }
                    }
                });

                span.addEventListener('click', function () {
                    if (editPendingStart === -1) {
                        // First click — set range start
                        editPendingStart = idx;
                        tokenCont.querySelectorAll('span').forEach(function (s) {
                            delete s.dataset.selected;
                            s.style.background = '#fff'; s.style.color = '#333'; s.style.fontWeight = '400';
                        });
                        span.dataset.selected = '1';
                        span.style.background = '#0d6efd'; span.style.color = '#fff'; span.style.fontWeight = '600';
                        tokenHint.innerHTML = '<strong class="text-success">✓ "' + escHtml(tok) + '" selected.</strong> Click another word to extend, or proceed.';
                        applyPickerSelection(tokens, idx, idx);

                    } else if (editPendingStart === idx) {
                        // Deselect
                        editPendingStart = -1;
                        tokenCont.querySelectorAll('span').forEach(function (s) {
                            delete s.dataset.selected; s.style.background = '#fff'; s.style.color = '#333'; s.style.fontWeight = '400';
                        });
                        tokenHint.innerHTML = '<strong>Click once</strong> to select a word. <strong>Click a second word</strong> to extend.';
                        previewDiv.style.display = 'none';

                    } else {
                        // Second click — extend range
                        var from2 = Math.min(editPendingStart, idx), to2 = Math.max(editPendingStart, idx);
                        editPendingStart = -1;
                        tokenCont.querySelectorAll('span').forEach(function (s, si) {
                            delete s.dataset.selected;
                            if (si >= from2 && si <= to2) {
                                s.dataset.selected = '1';
                                s.style.background = '#0d6efd'; s.style.color = '#fff'; s.style.fontWeight = '600';
                            } else {
                                s.style.background = '#fff'; s.style.color = '#333'; s.style.fontWeight = '400';
                            }
                        });
                        var selTxt = tokens.slice(from2, to2 + 1).join(' ');
                        tokenHint.innerHTML = '<strong class="text-success">✓ "' + escHtml(selTxt) + '" selected.</strong> Click any word to restart.';
                        applyPickerSelection(tokens, from2, to2);
                    }
                });

                tokenCont.appendChild(span);
            });

            tokenSec.style.display = '';
        }

        function applyPickerSelection(tokens, from3, to3) {
            var ct = ctSelect.value;
            var ft = document.getElementById('FieldType').value || 'string';
            var sel = tokens.slice(from3, to3 + 1).join(' ');
            var rawPat = '';

            if (ct === 'regex_match') {
                var prefix = tokens.slice(0, from3).join(' ').trimEnd();
                var esc2   = escPat(prefix)
                    .replace(/\\ /g, '\\s+')
                    .replace(/\\\$/g, '\\$?');
                esc2 = esc2
                    .replace(/\d{1,2}\/\d{1,2}\/\d{2,4}/g, '\\S+')
                    .replace(/\d{4}-\d{2}-\d{2}/g, '\\S+')
                    .replace(/\d{1,2}-\d{1,2}-\d{2,4}/g, '\\S+');
                var capGrp = pickerCapGroup(ft, sel);
                rawPat = prefix ? (esc2 + '\\s+\\$?\\s*' + capGrp) : capGrp;

                // Show readable in the visible input, raw in hidden field
                var readable = toReadable(rawPat);
                patInput.value = readable || rawPat;
                document.getElementById('RegexPattern').value = rawPat;
                _patReadableMode = !!(readable && readable !== rawPat);

            } else if (ct === 'starts_with') {
                rawPat = tokens.slice(0, to3 + 1).join(' ');
                patInput.value = rawPat;
                _patReadableMode = false;
            } else if (ct === 'ends_with') {
                rawPat = tokens.slice(from3).join(' ');
                patInput.value = rawPat;
                _patReadableMode = false;
            } else if (ct === 'equals') {
                rawPat = tokens.join(' ');
                patInput.value = rawPat;
                _patReadableMode = false;
            } else {
                rawPat = sel;
                patInput.value = rawPat;
                _patReadableMode = false;
            }

            syncConditionHiddens();
            updateRegexReadable();
            updatePreview();

            previewCode.textContent = rawPat;
            previewDiv.style.display = '';
        }

        function pickerCapGroup(ft, val) {
            if (ft === 'date')    return '([\\d/\\-]+)';
            if (ft === 'decimal') return '([\\-\\d,]+\\.\\d{2})';
            if (val && val.indexOf(' ') >= 0) return '([^\\r\\n]+?)';
            return '(\\S+)';
        }

        // Re-render token picker when condition type changes (title/behavior changes)
        ctSelect.addEventListener('change', function () {
            var selLine = linesList.querySelector('.edit-line-pick.selected');
            if (selLine) renderTokenPicker(selLine.textContent);
        });
    })();

    // Initial preview
    updatePreview();

    // ── Bootstrap popovers ────────────────────────────────────────────────────
    document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (el) {
        new bootstrap.Popover(el, { sanitize: false });
    });
})();
</script>
}
