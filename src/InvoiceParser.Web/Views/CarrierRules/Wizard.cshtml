@{
    ViewData["Title"] = "Add Extraction Rule";
    int carrierId      = (int)ViewBag.CarrierId;
    string carrierName = ViewBag.CarrierName ?? "Carrier";
    string? section    = ViewBag.Section as string;
    string? sectionLabel = ViewBag.SectionLabel as string;
    // A section label means the wizard was opened from a specific table's "+ Add" button.
    // The field grid will be pre-filtered to show only that table's fields.
    string step1Heading = sectionLabel != null
        ? $"Step 1 — Choose the <strong>{sectionLabel}</strong> field to extract"
        : "Step 1 — What are you teaching the parser to find?";
    string step1Subtext = sectionLabel != null
        ? $"Showing only <strong>{sectionLabel}</strong> fields. To add a rule for a different section, go back and click + Add in that section."
        : "Select the field this rule will extract from the invoice.";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Carriers">Carriers</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-carrierId="@carrierId">@carrierName</a></li>
        <li class="breadcrumb-item active">Add Rule</li>
    </ol>
</nav>

<!-- Step indicator -->
<div class="d-flex align-items-center gap-0 mb-4" id="stepIndicator">
    <div class="step-pill active" data-step="1">
        <span class="step-num">1</span>
        <span class="step-lbl">Choose Field</span>
    </div>
    <div class="step-line"></div>
    <div class="step-pill" data-step="2">
        <span class="step-num">2</span>
        <span class="step-lbl">Find It</span>
    </div>
    <div class="step-line"></div>
    <div class="step-pill" data-step="3">
        <span class="step-num">3</span>
        <span class="step-lbl">Clean Up &amp; Save</span>
    </div>
</div>

<!-- ═══ STEP 1 — Choose field ═══════════════════════════════════════════ -->
<div class="wizard-step" id="step1">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Html.Raw(step1Heading)</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">@Html.Raw(step1Subtext)</p>
            <div class="row g-2" id="fieldGrid"></div>
            <div id="noFieldsMsg" class="alert alert-warning mt-3" style="display:none;">
                No fields configured for this section yet.
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <a asp-action="Index" asp-route-carrierId="@carrierId" class="btn btn-outline-secondary">Cancel</a>
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Create" asp-route-carrierId="@carrierId" class="text-muted small">
                    Advanced / Developer mode →
                </a>
                <button class="btn btn-primary" id="step1Next" disabled>Next →</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ STEP 2 — Find it in the invoice ════════════════════════════════ -->
<div class="wizard-step" id="step2" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Step 2 — Click the line that contains this value</h5>
            <span class="badge bg-light text-primary" id="step2FieldBadge"></span>
        </div>
        <div class="card-body">

            <div id="noPdfTextMsg" style="display:none;">
                <div class="alert alert-info mb-3">
                    <strong>No invoice stored for this carrier yet.</strong>
                    Upload a sample invoice PDF below — it will be used just for this session to help you define rules.
                    The file won't be saved or processed permanently.
                </div>

                <!-- Drop zone -->
                <div id="pdfDropZone"
                     class="border rounded d-flex flex-column align-items-center justify-content-center text-center p-5"
                     style="border-style:dashed!important;border-width:2px!important;border-color:#6c757d;cursor:pointer;background:#f8f9fa;min-height:180px;transition:background .15s,border-color .15s;">
                    <div style="font-size:2.5rem;">📄</div>
                    <p class="mb-1 fw-semibold">Drag &amp; drop a PDF here</p>
                    <p class="text-muted small mb-3">or click to browse</p>
                    <input type="file" id="pdfFileInput" accept=".pdf,.jpg,.jpeg,.png,.tiff,.tif"
                           style="display:none;" />
                    <button type="button" class="btn btn-outline-primary btn-sm" id="browseFileBtn">
                        Browse file…
                    </button>
                </div>

                <div id="uploadProgress" class="mt-3" style="display:none;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <span id="uploadProgressMsg" class="text-muted small">Extracting text from PDF…</span>
                    </div>
                </div>
                <div id="uploadError" class="alert alert-danger mt-3" style="display:none;"></div>
            </div>

            <div id="pdfLinesSection">
                <p class="text-muted small mb-2">
                    Click the line that contains the <strong id="step2FieldLabel"></strong>.
                    The line is from the most recent invoice uploaded for <strong>@carrierName</strong>.
                </p>
                <div class="input-group input-group-sm mb-3" style="max-width:320px;">
                    <span class="input-group-text bg-white border-end-0">🔍</span>
                    <input type="text" id="lineSearch" class="form-control border-start-0 ps-0"
                           placeholder="Filter lines…" autocomplete="off" />
                </div>
                <div id="pdfLinesList" class="border rounded" style="max-height:340px;overflow-y:auto;background:#f8f9fa;"></div>
            </div>

            <div id="selectedLinePanel" class="mt-3" style="display:none;">
                <hr />
                <p class="fw-semibold mb-1">Selected line:</p>
                <div id="selectedLineHighlight" class="p-2 rounded border font-monospace small mb-2"
                     style="background:#fff;word-break:break-all;"></div>

                <!-- Token picker: click word(s) to define value or match text -->
                <div id="wizTokenPickerWrap" class="mb-3" style="display:none;">
                    <label class="form-label small fw-semibold mb-1" id="wizTokenPickerLabel">
                        Click the word that is the <span class="text-primary fw-bold">value</span> you want to capture:
                    </label>
                    <div id="wizLineTokens" class="border rounded px-2 py-2 bg-white font-monospace"
                         style="font-size:0.82rem;line-height:2.2;word-break:break-all;"></div>
                    <div class="form-text" id="wizTokenPickerHint">
                        Each word is a button. <strong>Click once</strong> to select a single word.
                        <strong>Click a second word</strong> to extend the selection across multiple words.
                    </div>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label fw-semibold" id="extractedValueLabel">Value to capture</label>
                        <input type="text" id="extractedValue" class="form-control text-success fw-semibold"
                               placeholder="The value we will extract" />
                        <div class="form-text" id="extractedValueHint">Edit if the detected value is wrong.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" id="conditionPickerLabel">What should the rule do?</label>
                        <select id="conditionTypePicker" class="form-select">
                            <option id="condOptRegexMatch" value="regex_match">🎯 Extract a specific value (recommended)</option>
                            <option value="starts_with">🔍 Line starts with…</option>
                            <option value="contains">🔍 Line contains…</option>
                            <option value="equals">🔍 Exact line match</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-outline-info w-100" id="redetectBtn">
                            ↻ Re-detect
                        </button>
                    </div>
                </div>

                <!-- Warning: simple mode chosen for a value-extracting field -->
                <div id="wizSimpleModeWarning" class="alert alert-warning py-2 px-3 small mt-2" style="display:none;">
                    <strong>⚠ Heads-up:</strong> This mode records the <em>entire matching line</em> as the field value.
                    If you need to capture just a number, date, or code, choose
                    <strong>"Extract a specific value"</strong> instead.
                </div>

                <!-- Date-in-prefix warning (now informational — date is auto-generalized) -->
                <div id="wizDatePrefixWarning" class="alert alert-info py-2 px-3 small mt-2" style="display:none;">
                    <strong>✓ Date automatically generalized:</strong> The text before your value contained a
                    <strong>date or billing period</strong> — it has been replaced with <code>[skip]</code>
                    in the pattern so the rule keeps working on every future invoice.<br/>
                    <span class="mt-1 d-block text-muted">
                        If you want the date to stay exact, open <strong>⚙ Advanced</strong> and edit the raw pattern.
                    </span>
                </div>

                <!-- Plain-English rule preview -->
                <div id="wizRulePreview" class="alert alert-info py-2 px-3 small mt-2" style="display:none;">
                    <strong>✓ This rule will:</strong> <span id="wizRulePreviewText"></span>
                </div>

                <!-- Advanced: raw pattern (collapsed by default) -->
                <div class="mt-2 d-flex justify-content-end">
                    <button type="button" class="btn btn-link btn-sm p-0 text-muted small" id="wizToggleAdvanced">
                        ⚙ Advanced — show raw pattern
                    </button>
                </div>
                <div id="wizAdvancedPanel" style="display:none;" class="mt-1">
                    <label class="form-label small text-muted mb-1">
                        Raw rule pattern <em class="text-warning">(auto-generated — only edit if you know regex)</em>
                    </label>
                    <input type="text" id="generatedPattern" class="form-control form-control-sm font-monospace text-muted"
                           placeholder="Pattern will appear here…" />
                </div>
            </div>

        </div>
        <div class="card-footer d-flex justify-content-between">
            <button class="btn btn-outline-secondary" id="step2Back">← Back</button>
            <button class="btn btn-primary" id="step2Next" disabled>Next →</button>
        </div>
    </div>
</div>

<!-- ═══ STEP 3 — Clean up & Save ════════════════════════════════════════ -->
<div class="wizard-step" id="step3" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Step 3 — Clean Up &amp; Save</h5>
            <span class="badge bg-light text-primary" id="step3FieldBadge"></span>
        </div>
        <div class="card-body">

            <!-- Summary -->
            <div class="alert alert-light border mb-4">
                <div class="row g-2 small">
                    <div class="col-sm-3 text-muted">Field</div>
                    <div class="col-sm-9 fw-semibold" id="summaryField"></div>
                    <div class="col-sm-3 text-muted">Matched line</div>
                    <div class="col-sm-9 font-monospace" id="summaryLine" style="word-break:break-all;"></div>
                    <div class="col-sm-3 text-muted">Raw value</div>
                    <div class="col-sm-9"><code id="summaryRaw"></code></div>
                </div>
            </div>

            <!-- Transform options -->
            <div id="transformOptions"></div>

            <!-- Noise removal section — visual token picker, no regex required -->
            <div id="customRemoveSection" style="display:none;" class="border rounded p-3 mb-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fw-semibold small">🧹 Still see noise? Click the word(s) you want removed:</span>
                </div>
                <p class="text-muted small mb-2">
                    Click one word to select it. Click a second word to extend the selection.
                    Then press <strong>Remove</strong> — that text will be stripped from every matching charge description.
                </p>
                <!-- Token badges representing the current raw value -->
                <div id="noiseTokens" class="border rounded px-2 py-2 bg-white mb-1"
                     style="font-size:0.85rem;line-height:2.4;word-break:break-all;font-family:monospace;min-height:38px;"></div>
                <div class="form-text mb-2" id="noiseTokenHint">
                    Each word is a button — click to mark for removal.
                </div>
                <!-- Inline preview -->
                <div id="noiseRemovePreview" class="small mb-2" style="display:none;">
                    <span class="text-muted">After removal:</span>
                    <code class="text-success fw-semibold ms-1" id="noiseRemovePreviewText"></code>
                </div>
                <!-- Quick-detect one-click buttons (auto-populated from raw value) -->
                <div id="noiseQuickBtns" class="d-flex flex-wrap gap-2 mb-2"></div>
                <!-- Action -->
                <button type="button" class="btn btn-sm btn-danger" id="addNoiseRemoveBtn" style="display:none;">
                    ➕ Remove selected text from all charges
                </button>
            </div>

            <!-- Preview -->
            <div class="mt-3">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <span class="fw-semibold">Final value that will be saved:</span>
                    <code class="fs-5 text-success" id="finalValuePreview"></code>
                </div>
                <div id="previewWarning" class="text-warning small" style="display:none;">
                    ⚠ Value looks unchanged — consider adding a cleanup step if needed.
                </div>
            </div>

        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <button class="btn btn-outline-secondary" id="step3Back">← Back</button>
            <button class="btn btn-success px-4" id="saveWizardBtn">
                ✓ Save Rule
            </button>
        </div>
    </div>
    <div id="saveResultBox" class="mt-3" style="display:none;"></div>
</div>

<!-- Hidden form (submitted on save) -->
<form id="wizardForm" asp-controller="CarrierRules" asp-action="QuickCreate" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CarrierId"          id="hCarrierId"       value="@carrierId" />
    <input type="hidden" name="FieldName"          id="hFieldName" />
    <input type="hidden" name="RegexPattern"       id="hRegexPattern" />
    <input type="hidden" name="ConditionType"      id="hConditionType" />
    <input type="hidden" name="ConditionSource"    id="hConditionSource" value="line_text" />
    <input type="hidden" name="TargetTable"        id="hTargetTable" />
    <input type="hidden" name="FieldType"          id="hFieldType" />
    <input type="hidden" name="TransformationsJson"    id="hTransforms" />
    <input type="hidden" name="SortOrder"              id="hSortOrder"              value="10" />
    <input type="hidden" name="IsActive"               id="hIsActive"               value="true" />
    <input type="hidden" name="DescriptionLineOffset"  id="hDescriptionLineOffset"  value="-1" />
</form>

@section Scripts {
<style>
    /* Step indicator */
    .step-pill {
        display: flex; align-items: center; gap: 8px;
        padding: 6px 14px; border-radius: 20px;
        background: #e9ecef; color: #6c757d;
        font-size: .85rem; font-weight: 600;
        transition: background .2s, color .2s;
        white-space: nowrap;
    }
    .step-pill.active   { background: #0d6efd; color: #fff; }
    .step-pill.done     { background: #198754; color: #fff; }
    .step-pill.done .step-num::before { content: '✓ '; }
    .step-num { font-size: .75rem; }
    .step-line { flex: 1; height: 2px; background: #dee2e6; min-width: 20px; }

    /* PDF line list */
    .pdf-line {
        padding: 5px 10px; cursor: pointer; font-size: .8rem;
        font-family: monospace; border-bottom: 1px solid #eee;
        transition: background .1s;
    }
    .pdf-line:hover   { background: #e7f1ff; }
    .pdf-line.selected { background: #0d6efd; color: #fff; }
    .pdf-line.line-hidden { display: none; }

    /* Value highlight in selected line */
    .val-highlight { background: #fff3cd; border-radius: 3px; padding: 0 2px; font-weight: 700; }
    .pdf-line.selected .val-highlight { background: #ffc107; color: #000; }

    /* Field card grid */
    .field-card {
        border: 2px solid #dee2e6; border-radius: 8px; padding: 12px 14px;
        cursor: pointer; transition: border-color .15s, background .15s;
        height: 100%;
    }
    .field-card:hover   { border-color: #0d6efd; background: #f0f6ff; }
    .field-card.selected { border-color: #0d6efd; background: #e7f1ff; }
    .field-card .field-label { font-weight: 600; font-size: .9rem; }
    .field-card .field-desc  { font-size: .75rem; color: #6c757d; margin-top: 4px; }

    /* Transform option rows */
    .transform-opt { border: 1px solid #dee2e6; border-radius: 6px; padding: 10px 14px; margin-bottom: 10px; }
    .transform-opt.active { border-color: #0d6efd; background: #f0f6ff; }
</style>

<script>
(function () {

// ── Data from server ────────────────────────────────────────────────────────
var CARRIER_ID   = @carrierId;
var PDF_LINES    = @Html.Raw(ViewBag.PdfLinesJson ?? "[]");
var ALL_FIELDS   = @Html.Raw(ViewBag.FriendlyFieldsJson ?? "[]");
var SECTION      = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(section ?? ""));

// If opened from a specific section's "+ Add", filter fields to that table only
var FIELD_DEFS   = SECTION
    ? ALL_FIELDS.filter(function (f) { return f.targetTable === SECTION; })
    : ALL_FIELDS;

// ── Wizard state ────────────────────────────────────────────────────────────
var state = {
    step:           1,
    fieldDef:       null,   // { label, fieldName, targetTable, fieldType, description }
    selectedLine:   '',
    selectedLineIdx: -1,
    extractedValue: '',
    conditionType:  'regex_match',
    generatedPattern: '',
    transforms:     [],
    finalValue:     '',
};

// ── Step navigation ─────────────────────────────────────────────────────────
function goTo(n) {
    state.step = n;
    document.querySelectorAll('.wizard-step').forEach(function (el, i) {
        el.style.display = (i + 1 === n) ? '' : 'none';
    });
    document.querySelectorAll('.step-pill').forEach(function (pill) {
        var s = parseInt(pill.getAttribute('data-step'));
        pill.classList.toggle('active', s === n);
        pill.classList.toggle('done',   s < n);
    });
    if (n === 2) renderStep2();
    if (n === 3) renderStep3();
}

// ═══ STEP 1 ─────────────────────────────────────────────────────────────────

var fieldGrid = document.getElementById('fieldGrid');

if (FIELD_DEFS.length === 0) {
    document.getElementById('noFieldsMsg').style.display = '';
} else {
    // Group by targetTable so fields are visually clustered when no section filter is active
    var tableOrder   = ['t_invoice', 't_charge', 't_usage', 't_inventory'];
    var tableLabels  = {
        t_invoice:   'Invoice Summary',
        t_charge:    'Line Item Charges',
        t_usage:     'Usage Records',
        t_inventory: 'Inventory',
    };
    var tableBadge   = {
        t_invoice:   'bg-primary',
        t_charge:    'bg-success',
        t_usage:     'bg-info text-dark',
        t_inventory: 'bg-warning text-dark',
    };

    var byTable = {};
    FIELD_DEFS.forEach(function (fd) {
        (byTable[fd.targetTable] = byTable[fd.targetTable] || []).push(fd);
    });

    tableOrder.forEach(function (tbl) {
        var group = byTable[tbl];
        if (!group || group.length === 0) return;

        // Section heading — only shown when multiple tables are visible
        if (!SECTION) {
            var hdr = document.createElement('div');
            hdr.className = 'col-12 mt-3 mb-1';
            hdr.innerHTML =
                '<span class="badge ' + tableBadge[tbl] + ' me-2">' + tableLabels[tbl] + '</span>' +
                '<hr class="d-inline-block w-75 align-middle ms-2" style="margin-top:0;border-color:#dee2e6;" />';
            fieldGrid.appendChild(hdr);
        }

        group.forEach(function (fd) {
            var col = document.createElement('div');
            col.className = 'col-md-4 col-lg-3';
            col.innerHTML =
                '<div class="field-card" data-label="' + esc(fd.label) + '">' +
                    '<div class="field-label">' + esc(fd.label) + '</div>' +
                    '<div class="field-desc">'  + esc(fd.description) + '</div>' +
                '</div>';
            col.querySelector('.field-card').addEventListener('click', function () {
                document.querySelectorAll('.field-card').forEach(function (c) { c.classList.remove('selected'); });
                this.classList.add('selected');
                state.fieldDef = fd;
                document.getElementById('step1Next').disabled = false;
            });
            fieldGrid.appendChild(col);
        });
    });
}

document.getElementById('step1Next').addEventListener('click', function () {
    if (!state.fieldDef) return;
    goTo(2);
});

// ═══ STEP 2 ─────────────────────────────────────────────────────────────────

function renderStep2() {
    document.getElementById('step2FieldBadge').textContent = state.fieldDef.label;
    document.getElementById('step2FieldLabel').textContent = state.fieldDef.label;
    document.getElementById('step2Next').disabled = true;
    document.getElementById('selectedLinePanel').style.display = 'none';
    // Reset new UX elements
    document.getElementById('wizTokenPickerWrap').style.display    = 'none';
    document.getElementById('wizLineTokens').innerHTML             = '';
    document.getElementById('wizSimpleModeWarning').style.display  = 'none';
    document.getElementById('wizDatePrefixWarning').style.display  = 'none';
    document.getElementById('wizRulePreview').style.display        = 'none';
    document.getElementById('wizAdvancedPanel').style.display      = 'none';
    document.getElementById('wizToggleAdvanced').textContent       = '⚙ Advanced — show raw pattern';
    // Reset dynamic labels to defaults
    document.getElementById('extractedValueLabel').textContent = 'Value to capture';
    document.getElementById('extractedValueHint').textContent  = 'Edit if the detected value is wrong.';
    // Reset range selection state
    state.rangeStartIdx = -1;
    // Re-enable regex_match option (may have been disabled for boundary types)
    var rxOpt = document.getElementById('condOptRegexMatch');
    if (rxOpt) { rxOpt.disabled = false; rxOpt.style.display = ''; }
    document.getElementById('conditionPickerLabel').textContent = 'What should the rule do?';

    var listEl = document.getElementById('pdfLinesList');

    if (PDF_LINES.length === 0) {
        document.getElementById('noPdfTextMsg').style.display = '';
        document.getElementById('pdfLinesSection').style.display = 'none';

        // ── File upload wiring ───────────────────────────────────────────
        var dropZone   = document.getElementById('pdfDropZone');
        var fileInput  = document.getElementById('pdfFileInput');
        var browseBtn  = document.getElementById('browseFileBtn');
        var progressEl = document.getElementById('uploadProgress');
        var progressMsg= document.getElementById('uploadProgressMsg');
        var errorEl    = document.getElementById('uploadError');

        browseBtn.addEventListener('click', function () { fileInput.click(); });
        dropZone.addEventListener('click', function (e) {
            if (e.target !== browseBtn) fileInput.click();
        });

        // Drag visual feedback
        ['dragenter','dragover'].forEach(function (ev) {
            dropZone.addEventListener(ev, function (e) {
                e.preventDefault(); e.stopPropagation();
                dropZone.style.background = '#e7f1ff';
                dropZone.style.borderColor = '#0d6efd';
            });
        });
        ['dragleave','drop'].forEach(function (ev) {
            dropZone.addEventListener(ev, function (e) {
                e.preventDefault(); e.stopPropagation();
                dropZone.style.background = '#f8f9fa';
                dropZone.style.borderColor = '#6c757d';
            });
        });
        dropZone.addEventListener('drop', function (e) {
            var files = e.dataTransfer.files;
            if (files.length > 0) uploadFile(files[0]);
        });
        fileInput.addEventListener('change', function () {
            if (this.files.length > 0) uploadFile(this.files[0]);
        });

        function uploadFile(file) {
            errorEl.style.display = 'none';
            progressEl.style.display = '';
            progressMsg.textContent = 'Extracting text from "' + file.name + '"…';
            browseBtn.disabled = true;

            var formData = new FormData();
            formData.append('file', file);

            fetch('/CarrierRules/ExtractLines', { method: 'POST', body: formData })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                progressEl.style.display = 'none';
                browseBtn.disabled = false;

                if (data.error) {
                    errorEl.textContent = '⚠ ' + data.error;
                    errorEl.style.display = '';
                    return;
                }
                if (!data.lines || data.lines.length === 0) {
                    errorEl.textContent = '⚠ ' + (data.warning || 'No text lines were extracted from this file.');
                    errorEl.style.display = '';
                    return;
                }
                if (data.warning) {
                    errorEl.className = 'alert alert-warning mt-3';
                    errorEl.textContent = '⚠ ' + data.warning;
                    errorEl.style.display = '';
                }

                // Load the lines into PDF_LINES and show the list
                data.lines.forEach(function (l) { PDF_LINES.push(l); });
                document.getElementById('noPdfTextMsg').style.display = 'none';
                document.getElementById('pdfLinesSection').style.display = '';
                renderStep2();
            })
            .catch(function (err) {
                progressEl.style.display = 'none';
                browseBtn.disabled = false;
                errorEl.textContent = '⚠ Upload failed: ' + String(err);
                errorEl.style.display = '';
            });
        }

        return;
    }

    listEl.innerHTML = '';
    PDF_LINES.forEach(function (line, idx) {
        var div = document.createElement('div');
        div.className = 'pdf-line';
        div.setAttribute('data-idx', idx);
        div.setAttribute('data-text', line.toLowerCase());
        div.textContent = line;
        div.addEventListener('click', function () {
            document.querySelectorAll('.pdf-line').forEach(function (el) { el.classList.remove('selected'); });
            div.classList.add('selected');
            state.selectedLine    = line;
            state.selectedLineIdx = idx;
            onLineSelected(line);
        });
        listEl.appendChild(div);
    });

    // Line search
    document.getElementById('lineSearch').addEventListener('input', function () {
        var term = this.value.trim().toLowerCase();
        document.querySelectorAll('.pdf-line').forEach(function (el) {
            el.classList.toggle('line-hidden', term && !el.getAttribute('data-text').includes(term));
        });
    });
}

// ── Condition picker helper ────────────────────────────────────────────────
// mode: 'value' | 'match' | 'anchor'
function setConditionPickerMode(mode) {
    var sel   = document.getElementById('conditionTypePicker');
    var rxOpt = document.getElementById('condOptRegexMatch');
    var lbl   = document.getElementById('conditionPickerLabel');

    if (mode === 'match') {
        // Boundary / skip rules: no value to extract — only match conditions
        rxOpt.disabled = true; rxOpt.style.display = 'none';
        if (sel.value === 'regex_match') sel.value = 'starts_with';
        lbl.textContent = 'How should this line be matched?';
    } else if (mode === 'anchor') {
        // Anchors: only starts_with makes sense
        rxOpt.disabled = true; rxOpt.style.display = 'none';
        sel.value = 'starts_with';
        lbl.textContent = 'How should this line be matched?';
    } else {
        // Value fields: all options available
        rxOpt.disabled = false; rxOpt.style.display = '';
        lbl.textContent = 'What should the rule do?';
    }
    state.conditionType = sel.value;
}

function onLineSelected(line) {
    state.selectedLine  = line;
    state.rangeStartIdx = -1;
    var ft  = state.fieldDef.fieldType;
    var val = detectValue(line, ft);
    state.extractedValue = val;

    document.getElementById('extractedValue').value = val;
    renderHighlightedLine(line, val);

    if (ft === 'line_anchor' || ft === 'location_anchor') {
        setConditionPickerMode('anchor');
        // Anchor mode: user clicks WHERE the context value begins
        renderWizTokens(line, val, 'anchor');

    } else if (ft === 'skip' || ft === 'section_start' || ft === 'section_end' || ft === 'line_before_price') {
        // Match-only mode: no value extraction needed
        var defaultCt = (ft === 'skip' || ft === 'line_before_price') ? 'contains' : 'starts_with';
        document.getElementById('conditionTypePicker').value = defaultCt;
        setConditionPickerMode('match');
        renderWizTokens(line, val, 'match');

    } else {
        // Value-extracting fields — user clicks the word(s) that ARE the value
        setConditionPickerMode('value');
        document.getElementById('conditionTypePicker').value = 'regex_match';
        state.conditionType = 'regex_match';
        renderWizTokens(line, val, 'value');
    }

    buildPattern();

    document.getElementById('selectedLinePanel').style.display = '';
    document.getElementById('step2Next').disabled = false;
}

// ── Token picker ──────────────────────────────────────────────────────────────
var WIZ_DATE_IN_PREFIX = [
    /\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/i,
    /\b\d{4}\b/,
    /\d{1,2}\/\d{1,2}\/\d{2,4}/,
    /\d{1,2}-\d{1,2}-\d{2,4}/,
];

// ─── Direct range application (no click-event simulation) ──────────────────
function applyTokenRange(container, tokens, from, to) {
    var badges = Array.from(container.querySelectorAll('span'));
    badges.forEach(function (s, si) {
        delete s.dataset.selected;
        s.style.background = '#fff';
        s.style.color      = '#333';
        s.style.fontWeight = '400';
        s.style.opacity    = '1';
    });
    for (var i = from; i <= to; i++) {
        if (badges[i]) {
            badges[i].dataset.selected = '1';
            badges[i].style.background = '#0d6efd';
            badges[i].style.color      = '#fff';
            badges[i].style.fontWeight = '600';
        }
    }
    var newVal = tokens.slice(from, to + 1).join(' ');
    document.getElementById('extractedValue').value = newVal;
    state.extractedValue   = newVal;
    state.rangeStartIdx    = -1;
    renderHighlightedLine(state.selectedLine, newVal);
    buildPattern();
}

// mode: 'anchor' | 'value' | 'match'
//   anchor → click where context value STARTS; prefix before = pattern
//   value  → click word(s) that ARE the value; range selection supported
//   match  → click word(s) that identify the line (boundary/skip); range selection supported
function renderWizTokens(line, preselectedVal, mode) {
    var wrap      = document.getElementById('wizTokenPickerWrap');
    var container = document.getElementById('wizLineTokens');
    container.innerHTML = '';
    var tokens = line.trim().split(/\s+/);
    if (tokens.length < 2 && mode !== 'match') { wrap.style.display = 'none'; return; }
    if (tokens.length === 0) { wrap.style.display = 'none'; return; }

    var labelEl    = document.getElementById('wizTokenPickerLabel');
    var hintEl     = document.getElementById('wizTokenPickerHint');
    var valLabelEl = document.getElementById('extractedValueLabel');
    var valHintEl  = document.getElementById('extractedValueHint');

    if (mode === 'anchor') {
        labelEl.innerHTML      = 'Click where the <span class="text-primary fw-bold">phone number / location</span> begins on this line:';
        hintEl.textContent     = 'Everything before the clicked word becomes the anchor label. The rest is the context value.';
        valLabelEl.textContent = 'Context value (the phone / location)';
        valHintEl.textContent  = 'The parser uses this to group charges under the correct line or location.';
    } else if (mode === 'match') {
        labelEl.innerHTML      = 'Click the word(s) that <span class="text-warning fw-bold">identify</span> this line — click a second word to extend the selection:';
        hintEl.innerHTML       = '<strong>Click once</strong> to select a word. <strong>Click another word</strong> to extend the selection. The selected text becomes the match condition.';
        valLabelEl.textContent = 'Line must contain';
        valHintEl.textContent  = 'Edit the text that identifies this line.';
    } else {
        labelEl.innerHTML      = 'Click the word(s) that are the <span class="text-primary fw-bold">value</span> to capture — click a second word to extend:';
        hintEl.innerHTML       = '<strong>Click once</strong> to select a single word. <strong>Click another word</strong> to extend the selection across multiple words.';
        valLabelEl.textContent = 'Value to capture';
        valHintEl.textContent  = 'Edit if the detected value is wrong.';
    }

    // Local range-start tracking for this picker instance
    var pendingStart = -1;

    tokens.forEach(function (tok, idx) {
        var span = document.createElement('span');
        span.textContent = tok;
        span.className   = 'badge border me-1 mb-1';
        span.style.cssText = 'cursor:pointer;font-size:0.82rem;font-weight:400;background:#fff;color:#333;transition:background .1s;';

        if (mode === 'anchor') {
            span.title = 'Prefix = "' + tokens.slice(0, idx).join(' ') + '" → context starts at "' + tok + '"';
        } else {
            span.title = pendingStart === -1
                ? 'Click to select "' + tok + '"'
                : 'Click to extend selection to "' + tok + '"';
        }

        // ── Hover feedback ─────────────────────────────────────────────────
        span.addEventListener('mouseenter', function () {
            if (span.dataset.selected) return;
            if (mode === 'anchor') {
                container.querySelectorAll('span').forEach(function (s, si) {
                    if (!s.dataset.selected) s.style.background = si < idx ? '#fff3cd' : '#fff';
                });
                span.style.background = '#e7f0ff';
            } else if (pendingStart !== -1 && idx !== pendingStart) {
                // Show preview of range extension
                var from = Math.min(pendingStart, idx);
                var to   = Math.max(pendingStart, idx);
                container.querySelectorAll('span').forEach(function (s, si) {
                    if (si >= from && si <= to) s.style.background = '#cfe2ff';
                });
            } else {
                span.style.background = '#e7f0ff';
            }
        });
        span.addEventListener('mouseleave', function () {
            container.querySelectorAll('span').forEach(function (s) {
                if (!s.dataset.selected) s.style.background = '#fff';
            });
            // Re-apply selected highlight
            container.querySelectorAll('span[data-selected]').forEach(function (s) {
                s.style.background = '#0d6efd';
                s.style.color      = '#fff';
            });
            // Re-highlight pending-start
            if (pendingStart !== -1) {
                var ps = container.querySelectorAll('span')[pendingStart];
                if (ps) { ps.style.background = '#0d6efd'; ps.style.color = '#fff'; }
            }
        });

        // ── Click ──────────────────────────────────────────────────────────
        span.addEventListener('click', function () {

            if (mode === 'anchor') {
                // Clear all
                container.querySelectorAll('span').forEach(function (s, si) {
                    delete s.dataset.selected;
                    if (si < idx) {
                        s.style.background = '#ffc107'; s.style.color = '#000'; s.style.opacity = '0.7';
                    } else if (si === idx) {
                        s.dataset.selected = '1';
                        s.style.background = '#198754'; s.style.color = '#fff'; s.style.fontWeight = '600'; s.style.opacity = '1';
                    } else {
                        s.style.background = '#fff'; s.style.color = '#333'; s.style.fontWeight = '400'; s.style.opacity = '1';
                    }
                });
                var newVal = tokens.slice(idx).join(' ');
                document.getElementById('extractedValue').value = newVal;
                state.extractedValue = newVal;
                renderHighlightedLine(line, newVal);
                buildPattern();
                return;
            }

            // value / match modes — range selection
            if (pendingStart === -1) {
                // First click: set range start, highlight this token
                pendingStart = idx;
                container.querySelectorAll('span').forEach(function (s) {
                    delete s.dataset.selected;
                    s.style.background = '#fff'; s.style.color = '#333'; s.style.fontWeight = '400'; s.style.opacity = '1';
                });
                span.dataset.selected = '1';
                span.style.background = '#0d6efd';
                span.style.color      = '#fff';
                span.style.fontWeight = '600';
                var newVal = tok;
                document.getElementById('extractedValue').value = newVal;
                state.extractedValue = newVal;
                state.rangeStartIdx  = idx;
                renderHighlightedLine(line, newVal);
                buildPattern();
                // Update hint to indicate a range can be extended
                hintEl.innerHTML = '<strong class="text-success">✓ "' + esc(tok) + '" selected.</strong> Click another word to extend the selection, or proceed as-is.';
            } else if (pendingStart === idx) {
                // Clicking the same token again — deselect and reset
                pendingStart = -1;
                state.rangeStartIdx = -1;
                container.querySelectorAll('span').forEach(function (s) {
                    delete s.dataset.selected;
                    s.style.background = '#fff'; s.style.color = '#333'; s.style.fontWeight = '400'; s.style.opacity = '1';
                });
                document.getElementById('extractedValue').value = '';
                state.extractedValue = '';
                if (mode === 'match') {
                    hintEl.innerHTML = '<strong>Click once</strong> to select a word. <strong>Click another word</strong> to extend the selection. The selected text becomes the match condition.';
                } else {
                    hintEl.innerHTML = '<strong>Click once</strong> to select a single word. <strong>Click another word</strong> to extend the selection across multiple words.';
                }
                renderHighlightedLine(line, '');
                buildPattern();
            } else {
                // Second click on a different token → extend range
                var from = Math.min(pendingStart, idx);
                var to   = Math.max(pendingStart, idx);
                pendingStart = -1;
                applyTokenRange(container, tokens, from, to);
                var selectedText = tokens.slice(from, to + 1).join(' ');
                hintEl.innerHTML = '<strong class="text-success">✓ "' + esc(selectedText) + '" selected.</strong> Click any word to start a new selection.';
            }
        });

        container.appendChild(span);
    });

    // ── Pre-select based on auto-detected value ────────────────────────────
    if (preselectedVal && tokens.length > 0) {
        var preVal  = preselectedVal.trim();
        var joined  = tokens.join(' ');
        var matchPos = joined.toLowerCase().indexOf(preVal.toLowerCase());

        if (mode === 'anchor') {
            var firstTok = preVal.split(/\s+/)[0].toLowerCase();
            var fromIdx  = tokens.findIndex(function (t) { return t.toLowerCase() === firstTok; });
            if (fromIdx < 0) fromIdx = Math.min(1, tokens.length - 1);
            // Simulate click
            var badges = Array.from(container.querySelectorAll('span'));
            if (badges[fromIdx]) badges[fromIdx].click();

        } else if (matchPos >= 0) {
            // Map character offset → token index
            var charPos = 0, fromIdx = 0, toIdx = tokens.length - 1;
            for (var ti = 0; ti < tokens.length; ti++) {
                if (charPos <= matchPos) fromIdx = ti;
                charPos += tokens[ti].length;
                if (charPos >= matchPos + preVal.length) { toIdx = ti; break; }
                charPos++; // space
            }
            if (fromIdx === toIdx) {
                // Single token — simulate first click
                var badges2 = Array.from(container.querySelectorAll('span'));
                pendingStart = fromIdx;
                if (badges2[fromIdx]) {
                    badges2[fromIdx].dataset.selected = '1';
                    badges2[fromIdx].style.background = '#0d6efd';
                    badges2[fromIdx].style.color      = '#fff';
                    badges2[fromIdx].style.fontWeight = '600';
                }
                state.rangeStartIdx = fromIdx;
                document.getElementById('extractedValue').value = tokens[fromIdx];
                state.extractedValue = tokens[fromIdx];
            } else {
                // Multi-token range — apply directly
                applyTokenRange(container, tokens, fromIdx, toIdx);
                var selText = tokens.slice(fromIdx, toIdx + 1).join(' ');
                hintEl.innerHTML = '<strong class="text-success">✓ "' + esc(selText) + '" selected.</strong> Click any word to start a new selection.';
            }
        } else {
            // Fallback: select the last token
            var badges3 = Array.from(container.querySelectorAll('span'));
            var li = badges3.length - 1;
            pendingStart = li;
            if (badges3[li]) {
                badges3[li].dataset.selected = '1';
                badges3[li].style.background = '#0d6efd';
                badges3[li].style.color      = '#fff';
                badges3[li].style.fontWeight = '600';
            }
            state.rangeStartIdx = li;
            document.getElementById('extractedValue').value = tokens[li];
            state.extractedValue = tokens[li];
        }
    }

    renderHighlightedLine(line, document.getElementById('extractedValue').value);
    buildPattern();
    wrap.style.display = '';
}

document.getElementById('wizToggleAdvanced').addEventListener('click', function () {
    var panel   = document.getElementById('wizAdvancedPanel');
    var showing = panel.style.display !== 'none';
    panel.style.display = showing ? 'none' : '';
    this.textContent    = showing ? '⚙ Advanced — show raw pattern' : '⚙ Advanced — hide raw pattern';
});

function detectValue(line, fieldType) {
    // Date
    if (fieldType === 'date') {
        var dm;
        dm = line.match(/\b(\d{1,2}\/\d{1,2}\/\d{2,4})\b/);  if (dm) return dm[1];
        dm = line.match(/\b(\d{1,2}-\d{1,2}-\d{2,4})\b/);     if (dm) return dm[1];
        dm = line.match(/\b((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\w*\.?\s+\d{1,2},?\s+\d{4})\b/i); if (dm) return dm[1];
        dm = line.match(/\b(\d{4}-\d{2}-\d{2})\b/);            if (dm) return dm[1];
    }
    // Amount
    if (fieldType === 'decimal') {
        // prefer last amount-like token
        var matches = [...line.matchAll(/\$?\s*(-?[\d,]+\.\d{2})\b/g)];
        if (matches.length > 0) return matches[matches.length - 1][1].replace(/[,$]/g,'').trim();
    }
    // Line / Location anchor — everything after the first "keyword " prefix
    if (fieldType === 'line_anchor' || fieldType === 'location_anchor') {
        var parts = line.split(/\s+/);
        // try to find where the "meaningful" part starts (after FOR, Service at:, etc.)
        if (parts.length > 1) return parts.slice(1).join(' ');
        return line;
    }
    // Skip — entire line (user usually wants to match a distinctive phrase)
    if (fieldType === 'skip') {
        return line.trim();
    }
    // Section boundary & line_before_price — the whole line IS the matching target.
    if (fieldType === 'section_start' || fieldType === 'section_end' || fieldType === 'line_before_price') {
        return line.trim();
    }
    // Charge description — return the whole line stripped of trailing amount and noise.
    // The user will clean up remaining noise with a regex_remove transform in Step 3.
    if (state.fieldDef && state.fieldDef.fieldName === 'charge_desc') {
        var desc = line
            .replace(/\$?\s*-?[\d,]+\.\d{2}\s*$/, '') // strip trailing dollar amount
            .replace(/\s*\d{1,2}\/\d{1,2}\/\d{2,4}\s*$/, '') // strip trailing MM/DD/YY date
            .replace(/\s*\d{4}-\d{2}-\d{2}\s*$/, '')           // strip trailing YYYY-MM-DD date
            .trim();
        return desc || line.trim();
    }
    // String — try to get the last whitespace token
    var tokens = line.trim().split(/\s+/);
    return tokens[tokens.length - 1] || line;
}

function renderHighlightedLine(line, value) {
    var el = document.getElementById('selectedLineHighlight');
    if (!value) { el.textContent = line; return; }
    var idx = line.toLowerCase().indexOf(value.toLowerCase());
    if (idx < 0) { el.textContent = line; return; }
    el.innerHTML =
        esc(line.substring(0, idx)) +
        '<span class="val-highlight">' + esc(line.substring(idx, idx + value.length)) + '</span>' +
        esc(line.substring(idx + value.length));
}

function buildPattern() {
    var line  = state.selectedLine;
    var val   = document.getElementById('extractedValue').value.trim();
    var ct    = document.getElementById('conditionTypePicker').value;
    var ft    = state.fieldDef.fieldType;
    state.conditionType = ct;

    var pattern = '';
    var prefix  = '';

    var isBoundary   = (ft === 'skip' || ft === 'section_start' || ft === 'section_end' || ft === 'line_before_price');
    var isAnchor     = (ft === 'line_anchor' || ft === 'location_anchor');
    var isValueField = !isBoundary && !isAnchor;

    if (ct === 'starts_with' || ct === 'contains' || ct === 'equals') {
        if (isAnchor) {
            var vi = line.toLowerCase().indexOf(val.toLowerCase());
            pattern = vi > 0 ? line.substring(0, vi).trimEnd() : line;
            prefix  = pattern;
        } else {
            // For boundary/skip and simple-match: pattern is the selected text
            pattern = val || line;
        }
    } else {
        // regex_match — only for value fields
        var valueIdx = val ? line.toLowerCase().indexOf(val.toLowerCase()) : -1;
        if (valueIdx >= 0) {
            prefix = line.substring(0, valueIdx).trimEnd();
            var escaped = escapeRegex(prefix)
                .replace(/\\ /g, '\\s+')
                .replace(/\\\$/g, '\\$?');
            // Generalize date/number tokens in the prefix so the rule
            // is not tied to this specific invoice month.  A date changes
            // every billing cycle and would cause the rule to stop matching;
            // replacing it with \S+ skips whatever token sits in that position.
            escaped = escaped
                .replace(/\d{1,2}\/\d{1,2}\/\d{2,4}/g, '\\S+')   // MM/DD/YYYY or MM/DD/YY
                .replace(/\d{4}-\d{2}-\d{2}/g, '\\S+')              // YYYY-MM-DD
                .replace(/\d{1,2}-\d{1,2}-\d{2,4}/g, '\\S+');       // MM-DD-YYYY
            pattern = escaped + '\\s+\\$?\\s*' + capGroup(ft, val);
        } else {
            pattern = escapeRegex(line);
        }
    }

    state.generatedPattern = pattern;
    document.getElementById('generatedPattern').value = pattern;
    renderHighlightedLine(line, val);

    // ── Plain-English preview ───────────────────────────────────────────────
    var previewDiv  = document.getElementById('wizRulePreview');
    var previewSpan = document.getElementById('wizRulePreviewText');

    if (ft === 'skip' && val) {
        var ml = ct === 'starts_with' ? 'starts with' : (ct === 'contains' ? 'contains' : 'exactly matches');
        previewSpan.innerHTML = 'Skip any charge line that <strong>' + ml + '</strong> <strong class="text-danger">"' + esc(val) + '"</strong>.';
        previewDiv.style.display = '';
    } else if (ft === 'section_start' && val) {
        var ml2 = ct === 'starts_with' ? 'starts with' : (ct === 'contains' ? 'contains' : 'matches');
        previewSpan.innerHTML = 'When a line <strong>' + ml2 + '</strong> <strong class="text-success">"' + esc(val) + '"</strong> — start collecting charges below it.';
        previewDiv.style.display = '';
    } else if (ft === 'section_end' && val) {
        var ml3 = ct === 'starts_with' ? 'starts with' : (ct === 'contains' ? 'contains' : 'matches');
        previewSpan.innerHTML = 'When a line <strong>' + ml3 + '</strong> <strong class="text-warning">"' + esc(val) + '"</strong> — stop collecting charges.';
        previewDiv.style.display = '';
    } else if (ft === 'line_before_price' && val) {
        var ml4 = ct === 'starts_with' ? 'starts with' : (ct === 'contains' ? 'contains' : 'exactly matches');
        previewSpan.innerHTML = 'When a price line <strong>' + ml4 + '</strong> <strong class="text-primary">"' + esc(val) + '"</strong> — automatically find the <strong>nearest product name above it</strong> and use it as the charge description.';
        previewDiv.style.display = '';
    } else if (ct === 'regex_match' && val && isValueField) {
        if (prefix) {
            previewSpan.innerHTML = 'Find lines containing <strong>"' + esc(prefix) + '"</strong> and capture the value that follows — currently <strong class="text-success">"' + esc(val) + '"</strong>.';
        } else {
            previewSpan.innerHTML = 'Find any line containing <strong class="text-success">"' + esc(val) + '"</strong> and capture it.';
        }
        previewDiv.style.display = '';
    } else if ((ct === 'starts_with' || ct === 'contains' || ct === 'equals') && pattern && isValueField) {
        var modeLabel = ct === 'starts_with' ? 'start with' : (ct === 'contains' ? 'contain' : 'exactly match');
        previewSpan.innerHTML = 'Capture the entire line that <strong>' + modeLabel + '</strong> <strong>"' + esc(pattern) + '"</strong>.';
        previewDiv.style.display = '';
    } else {
        previewDiv.style.display = 'none';
    }

    // ── Date-in-prefix warning ──────────────────────────────────────────────
    var dateWarn   = document.getElementById('wizDatePrefixWarning');
    var hasDatePfx = ct === 'regex_match' && prefix &&
                     WIZ_DATE_IN_PREFIX.some(function (re) { return re.test(prefix); });
    dateWarn.style.display = hasDatePfx ? '' : 'none';

    // ── Simple-mode warning (only for value-extracting fields) ──────────────
    var simpleWarn = document.getElementById('wizSimpleModeWarning');
    simpleWarn.style.display = (ct !== 'regex_match' && isValueField) ? '' : 'none';
}

// Returns a regex capture group appropriate for the field type and captured value
function capGroup(fieldType, capturedVal) {
    if (fieldType === 'date')    return '([\\d/\\-]+)';
    if (fieldType === 'decimal') return '([\\-\\d,]+\\.\\d{2})';
    // Multi-word values need a broader group
    if (capturedVal && capturedVal.indexOf(' ') >= 0) return '([^\\r\\n]+?)';
    return '(\\S+)';
}

// live update on value / condition changes
document.getElementById('extractedValue').addEventListener('input', function () {
    state.extractedValue = this.value.trim();
    buildPattern();
});
document.getElementById('conditionTypePicker').addEventListener('change', buildPattern);
document.getElementById('generatedPattern').addEventListener('input', function () {
    state.generatedPattern = this.value;
});
document.getElementById('redetectBtn').addEventListener('click', function () {
    if (state.selectedLine) onLineSelected(state.selectedLine);
});

document.getElementById('step2Back').addEventListener('click', function () { goTo(1); });
document.getElementById('step2Next').addEventListener('click', function () {
    state.generatedPattern = document.getElementById('generatedPattern').value.trim();
    state.extractedValue   = document.getElementById('extractedValue').value.trim();
    state.conditionType    = document.getElementById('conditionTypePicker').value;
    goTo(3);
});

// ═══ STEP 3 ─────────────────────────────────────────────────────────────────

function renderStep3() {
    var fd  = state.fieldDef;
    var ft  = fd.fieldType;
    var raw = state.extractedValue;

    document.getElementById('step3FieldBadge').textContent = fd.label;
    document.getElementById('summaryField').textContent    = fd.label;
    document.getElementById('summaryLine').textContent     = state.selectedLine;
    document.getElementById('summaryRaw').textContent      = raw;

    state.transforms = [];
    var optContainer = document.getElementById('transformOptions');
    optContainer.innerHTML = '';

    // Section boundary, skip, and line_before_price rules — show info panel, no transforms needed
    if (ft === 'section_start' || ft === 'section_end' || ft === 'skip' || ft === 'line_before_price') {
        var infoMap = {
            section_start: { icon: '▶', title: 'Section Start rule',
                desc: 'When the parser sees a line matching this condition, it will <strong>start collecting charge rows</strong> below it.' },
            section_end:   { icon: '■', title: 'Section End rule',
                desc: 'When the parser sees a line matching this condition, it will <strong>stop collecting charge rows</strong>.' },
            skip:          { icon: '⊘', title: 'Skip Charge Line rule',
                desc: 'Any charge line that matches this condition will be <strong>excluded</strong> from the extracted charges.' },
            line_before_price: null  // handled separately below
        };

        if (ft === 'line_before_price') {
            renderLineBeforePriceStep3(optContainer);
        } else {
        var info = infoMap[ft];
        optContainer.innerHTML =
            '<div class="alert alert-info">' +
                '<strong>' + info.icon + ' ' + info.title + '</strong> — ' + info.desc +
                '<br/><span class="small text-muted mt-1 d-block">No value extraction or transforms are needed — just save and the rule will take effect on the next invoice upload.</span>' +
            '</div>';
        }
        document.getElementById('customRemoveSection').style.display = 'none';
        document.getElementById('finalValuePreview').textContent = '(match-only rule — no value captured)';
        document.getElementById('previewWarning').style.display = 'none';
        return; // skip normal suggestion rendering
    }

    // Build transform suggestions based on field type
    var suggestions = buildTransformSuggestions(ft, raw, state.conditionType);

    if (suggestions.length === 0) {
        optContainer.innerHTML = '<p class="text-muted">No cleanup needed — the value will be saved as-is.</p>';
    } else {
        suggestions.forEach(function (s) {
            var div = document.createElement('div');
            div.className = 'transform-opt';
            div.innerHTML =
                '<div class="form-check mb-0">' +
                    '<input class="form-check-input transform-chk" type="checkbox" id="t_' + s.id + '" ' +
                           (s.defaultOn ? 'checked' : '') + ' />' +
                    '<label class="form-check-label fw-semibold" for="t_' + s.id + '">' + s.label + '</label>' +
                '</div>' +
                '<div class="text-muted small mt-1">' + s.description + '</div>' +
                (s.preview ? '<div class="mt-1 small"><code>' + esc(raw) + '</code> → <code class="text-success">' + esc(s.preview) + '</code></div>' : '');
            div.querySelector('.transform-chk').addEventListener('change', function () {
                s.active = this.checked;
                rebuildTransforms(suggestions);
            });
            s.active = !!s.defaultOn;
            optContainer.appendChild(div);
        });
    }

    rebuildTransforms(suggestions);

    // Show "Add custom pattern removal" panel for string fields.
    // Always visible so users can manually enter any noise pattern even if auto-detection found nothing.
    var showCustomRemove = (ft === 'string');
    document.getElementById('customRemoveSection').style.display = showCustomRemove ? '' : 'none';

    if (showCustomRemove) {
        renderNoiseTokenPicker(raw, suggestions);
    }
}

// ── Noise token picker — visual removal, no regex required ───────────────────
function renderNoiseTokenPicker(raw, suggestions) {
    var container   = document.getElementById('noiseTokens');
    var hintEl      = document.getElementById('noiseTokenHint');
    var previewEl   = document.getElementById('noiseRemovePreview');
    var previewText = document.getElementById('noiseRemovePreviewText');
    var addBtn      = document.getElementById('addNoiseRemoveBtn');
    var quickBtns   = document.getElementById('noiseQuickBtns');

    container.innerHTML = '';
    quickBtns.innerHTML = '';
    previewEl.style.display = 'none';
    addBtn.style.display    = 'none';
    hintEl.textContent = 'Each word is a button — click to mark for removal.';

    var tokens = raw.trim().split(/\s+/);
    if (tokens.length === 0) return;

    var noiseStart = -1;   // index of first selected token

    // ── Render token badges ──────────────────────────────────────────────────
    tokens.forEach(function (tok, idx) {
        var span = document.createElement('span');
        span.textContent = tok;
        span.className   = 'badge border me-1 mb-1';
        span.style.cssText = 'cursor:pointer;font-size:0.85rem;font-weight:400;background:#fff;color:#333;transition:background .1s;';

        span.addEventListener('mouseenter', function () {
            if (span.dataset.selected) return;
            if (noiseStart !== -1 && idx !== noiseStart) {
                // Preview range extension on hover
                var from = Math.min(noiseStart, idx), to = Math.max(noiseStart, idx);
                container.querySelectorAll('span').forEach(function (s, si) {
                    if (si >= from && si <= to && !s.dataset.selected) s.style.background = '#fecaca';
                });
            } else {
                span.style.background = '#fecaca';
            }
        });
        span.addEventListener('mouseleave', function () {
            container.querySelectorAll('span').forEach(function (s) {
                if (!s.dataset.selected) s.style.background = '#fff';
            });
            container.querySelectorAll('span[data-selected]').forEach(function (s) {
                s.style.background = '#ef4444'; s.style.color = '#fff';
            });
        });

        span.addEventListener('click', function () {
            if (noiseStart === -1) {
                // First click — mark start
                noiseStart = idx;
                container.querySelectorAll('span').forEach(function (s) {
                    delete s.dataset.selected;
                    s.style.background = '#fff'; s.style.color = '#333'; s.style.textDecoration = '';
                });
                span.dataset.selected = '1';
                span.style.background = '#ef4444'; span.style.color = '#fff';
                span.style.textDecoration = 'line-through';

                var sel = tokens[idx];
                previewText.textContent = raw.replace(new RegExp(escapeRegex(sel), 'gi'), '').replace(/\s{2,}/g, ' ').trim() || '(empty)';
                previewEl.style.display = '';
                addBtn.style.display    = '';
                addBtn.dataset.pattern  = escapeRegex(sel);
                addBtn.dataset.label    = 'Remove "' + sel + '"';
                hintEl.innerHTML = '<strong class="text-danger">"' + esc(sel) + '"</strong> selected. Click another word to extend the selection, or press Remove.';

            } else if (noiseStart === idx) {
                // Deselect
                noiseStart = -1;
                container.querySelectorAll('span').forEach(function (s) {
                    delete s.dataset.selected;
                    s.style.background = '#fff'; s.style.color = '#333'; s.style.textDecoration = '';
                });
                previewEl.style.display = 'none';
                addBtn.style.display    = 'none';
                hintEl.textContent = 'Each word is a button — click to mark for removal.';

            } else {
                // Second click — extend range
                var from = Math.min(noiseStart, idx), to = Math.max(noiseStart, idx);
                noiseStart = -1;
                container.querySelectorAll('span').forEach(function (s, si) {
                    delete s.dataset.selected;
                    if (si >= from && si <= to) {
                        s.dataset.selected = '1';
                        s.style.background = '#ef4444'; s.style.color = '#fff'; s.style.textDecoration = 'line-through';
                    } else {
                        s.style.background = '#fff'; s.style.color = '#333'; s.style.textDecoration = '';
                    }
                });
                var selText = tokens.slice(from, to + 1).join(' ');
                var pat     = escapeRegex(selText);
                previewText.textContent = raw.replace(new RegExp(pat, 'gi'), '').replace(/\s{2,}/g, ' ').trim() || '(empty)';
                previewEl.style.display = '';
                addBtn.style.display    = '';
                addBtn.dataset.pattern  = pat;
                addBtn.dataset.label    = 'Remove "' + selText + '"';
                hintEl.innerHTML = '<strong class="text-danger">"' + esc(selText) + '"</strong> selected. Press Remove or click again to change.';
            }
        });

        container.appendChild(span);
    });

    // ── "Remove" button handler ─────────────────────────────────────────────
    // Guard: re-wire once per renderStep3 call by checking a marker
    var marker = 'noiseRemoveSection';
    var section = document.getElementById('customRemoveSection');
    if (section._noiseWired) {
        // Already wired — just update addBtn (it has dataset.pattern set per click)
    } else {
        section._noiseWired = true;
        addBtn.addEventListener('click', function () {
            var pat   = addBtn.dataset.pattern;
            var label = addBtn.dataset.label || 'Remove noise';
            if (!pat) return;

            var currentRaw = state.extractedValue;
            var preview    = currentRaw.replace(new RegExp(pat, 'gi'), '').replace(/\s{2,}/g, ' ').trim();

            var newSugg = {
                id:          'noise_' + Date.now(),
                label:       label,
                description: 'Removes this text from every captured charge description. Safe — if not found, the value is left unchanged.',
                step:        { Type: 'regex_remove', Value1: pat, Value2: null },
                preview:     preview,
                defaultOn:   true,
                active:      true,
            };
            suggestions.push(newSugg);

            // Append checkbox row to transformOptions
            var div = document.createElement('div');
            div.className = 'transform-opt';
            div.innerHTML =
                '<div class="form-check mb-0">' +
                    '<input class="form-check-input transform-chk" type="checkbox" id="t_' + newSugg.id + '" checked />' +
                    '<label class="form-check-label fw-semibold" for="t_' + newSugg.id + '">' + esc(label) + '</label>' +
                '</div>' +
                '<div class="text-muted small mt-1">' + newSugg.description + '</div>' +
                '<div class="mt-1 small"><code>' + esc(currentRaw) + '</code> → <code class="text-success">' + esc(preview) + '</code></div>';
            div.querySelector('.transform-chk').addEventListener('change', function () {
                newSugg.active = this.checked;
                rebuildTransforms(suggestions);
            });
            document.getElementById('transformOptions').appendChild(div);
            rebuildTransforms(suggestions);

            // Reset picker
            noiseStart = -1;
            container.querySelectorAll('span').forEach(function (s) {
                delete s.dataset.selected;
                s.style.background = '#fff'; s.style.color = '#333'; s.style.textDecoration = '';
            });
            previewEl.style.display = 'none';
            addBtn.style.display    = 'none';
            hintEl.textContent = 'Word removed ✓ Click another word to remove more.';
        });
    }

    // ── Quick-detect one-click buttons from raw value ────────────────────────
    var QUICK = [
        { re: /\d{1,2}\/\d{1,2}\/\d{2,4}/g,                     icon: '📅', label: 'Remove dates',         pat: '\\s*\\d{1,2}\\/\\d{1,2}\\/\\d{2,4}' },
        { re: /\d{4}-\d{2}-\d{2}/g,                              icon: '📅', label: 'Remove dates',         pat: '\\s*\\d{4}-\\d{2}-\\d{2}' },
        { re: /\d{1,2}\/\d{1,2}\s*[-–]\s*\d{1,2}\/\d{1,2}/g,    icon: '📅', label: 'Remove date ranges',   pat: '\\s*\\d{1,2}\\/\\d{1,2}\\s*[-\\u2013]\\s*\\d{1,2}\\/\\d{1,2}' },
        { re: /\b\d{3,}\b/g,                                     icon: '🔢', label: 'Remove numbers',       pat: null },  // generated dynamically
    ];

    QUICK.forEach(function (q) {
        var matches = raw.match(q.re);
        if (!matches || matches.length === 0) return;
        var uniq = matches.map(function (m) { return m.trim(); }).filter(function (v, i, a) { return a.indexOf(v) === i; });
        var pat  = q.pat || uniq.map(escapeRegex).join('|');
        var lbl  = uniq.length <= 3 ? q.icon + ' Remove ' + uniq.join(', ') : q.icon + ' ' + q.label;
        var preview = raw.replace(new RegExp(pat, 'gi'), '').replace(/\s{2,}/g, ' ').trim();
        if (preview === raw) return; // nothing changes

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-outline-danger btn-sm';
        btn.textContent = lbl;
        btn.addEventListener('click', function () {
            var newSugg = {
                id: 'quick_' + Date.now(), label: lbl,
                description: 'Removes these values from every captured charge description.',
                step: { Type: 'regex_remove', Value1: pat, Value2: null },
                preview: preview, defaultOn: true, active: true,
            };
            suggestions.push(newSugg);
            var div = document.createElement('div');
            div.className = 'transform-opt';
            div.innerHTML =
                '<div class="form-check mb-0">' +
                    '<input class="form-check-input transform-chk" type="checkbox" id="t_' + newSugg.id + '" checked />' +
                    '<label class="form-check-label fw-semibold" for="t_' + newSugg.id + '">' + esc(lbl) + '</label>' +
                '</div>' +
                '<div class="text-muted small mt-1">' + newSugg.description + '</div>' +
                '<div class="mt-1 small"><code>' + esc(raw) + '</code> → <code class="text-success">' + esc(preview) + '</code></div>';
            div.querySelector('.transform-chk').addEventListener('change', function () { newSugg.active = this.checked; rebuildTransforms(suggestions); });
            document.getElementById('transformOptions').appendChild(div);
            rebuildTransforms(suggestions);
            btn.disabled = true; btn.textContent += ' ✓';
        });
        quickBtns.appendChild(btn);
    });
}

function buildTransformSuggestions(fieldType, raw, conditionType) {
    var s = [];

    if (fieldType === 'date') {
        // Detect if it needs date conversion
        var stdDate = tryConvertDate(raw);
        if (stdDate && stdDate !== raw) {
            s.push({
                id: 'cvtdate', label: 'Convert to standard date format',
                description: 'Stores dates as yyyy-MM-dd so they sort and compare correctly.',
                step: { Type: 'convert_date', Value1: null, Value2: 'yyyy-MM-dd' },
                preview: stdDate, defaultOn: true, active: true,
            });
        }
    }

    if (fieldType === 'line_anchor' || fieldType === 'location_anchor') {
        // Detect prefix (the part before the value in the selected line)
        var line   = state.selectedLine;
        var valIdx = line.toLowerCase().indexOf(raw.toLowerCase());
        var prefix = valIdx > 0 ? line.substring(0, valIdx).trimEnd() : '';
        if (prefix) {
            s.push({
                id: 'rmpfx', label: 'Remove prefix "' + prefix + '"',
                description: 'Strips the leading label text, leaving only the value (e.g. removes "FOR " from "FOR 061-827-9465").',
                step: { Type: 'remove_prefix', Value1: prefix, Value2: null },
                preview: raw, defaultOn: true, active: true,
            });
        }
        s.push({
            id: 'trim', label: 'Trim extra spaces',
            description: 'Removes any leading or trailing whitespace.',
            step: { Type: 'trim', Value1: null, Value2: null },
            preview: raw.trim(), defaultOn: true, active: true,
        });
    }

    if (fieldType === 'skip') {
        // No transforms needed for skip rules
    }

    if (fieldType === 'section_start' || fieldType === 'section_end' || fieldType === 'line_before_price') {
        // Pure condition rules — no value extracted, no transforms needed.
        return s;
    }

    if (fieldType === 'string') {
        // ── Noise removal for charge descriptions ─────────────────────────────
        // Detect dynamic date/period patterns inside the captured value and offer
        // to remove them. These patterns change every billing cycle, so a simple
        // Replace won't work — regex_remove is the right tool.
        if (state.fieldDef && state.fieldDef.fieldName === 'charge_desc') {
            var NOISE_PATTERNS = [
                {
                    re: /\d{1,2}\/\d{1,2}\/\d{2,4}/,
                    label: 'Remove embedded MM/DD/YYYY date',
                    hint:  'e.g. "Monthly Fee 03/15/2026" → "Monthly Fee"',
                    pattern: '\\s*\\d{1,2}\\/\\d{1,2}\\/\\d{2,4}',
                },
                {
                    re: /\d{4}-\d{2}-\d{2}/,
                    label: 'Remove embedded YYYY-MM-DD date',
                    hint:  'e.g. "Data Plan 2026-03-01" → "Data Plan"',
                    pattern: '\\s*\\d{4}-\\d{2}-\\d{2}',
                },
                {
                    re: /(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\w*\.?\s+\d{1,2},?\s+\d{4}/i,
                    label: 'Remove embedded month-name date',
                    hint:  'e.g. "Service Fee March 1, 2026" → "Service Fee"',
                    pattern: '\\s*(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\w*\\.?\\s+\\d{1,2},?\\s+\\d{4}',
                },
                {
                    re: /\d{1,2}\/\d{1,2}\s*[-–]\s*\d{1,2}\/\d{1,2}/,
                    label: 'Remove billing period range (MM/DD–MM/DD)',
                    hint:  'e.g. "Voice 03/01-03/31" → "Voice"',
                    pattern: '\\s*\\d{1,2}\\/\\d{1,2}\\s*[-\\u2013]\\s*\\d{1,2}\\/\\d{1,2}',
                },
                {
                    re: /\(\s*\d{1,2}\/\d{1,2}\s*[-–]\s*\d{1,2}\/\d{1,2}\s*\)/,
                    label: 'Remove billing period in parentheses (MM/DD–MM/DD)',
                    hint:  'e.g. "Voice (03/01-03/31)" → "Voice"',
                    pattern: '\\s*\\(\\s*\\d{1,2}\\/\\d{1,2}\\s*[-\\u2013]\\s*\\d{1,2}\\/\\d{1,2}\\s*\\)',
                },
            ];

            var foundNoise = false;
            NOISE_PATTERNS.forEach(function (np, ni) {
                if (!np.re.test(raw)) return;
                foundNoise = true;
                var previewCleaned = raw.replace(new RegExp(np.pattern, 'gi'), '').trim();
                s.push({
                    id: 'rmpattern_' + ni,
                    label: np.label,
                    description: np.hint + '. The pattern is a regex that removes all occurrences — safe even when only some descriptions have this noise.',
                    step: { Type: 'regex_remove', Value1: np.pattern, Value2: null },
                    preview: previewCleaned,
                    defaultOn: true, active: true,
                });
            });
        }

        // Trim is always safe
        if (raw !== raw.trim()) {
            s.push({
                id: 'trim', label: 'Trim extra spaces',
                description: 'Removes leading/trailing whitespace.',
                step: { Type: 'trim', Value1: null, Value2: null },
                preview: raw.trim(), defaultOn: true, active: true,
            });
        }
    }

    // Join adjacent lines — offered for string, line_anchor, location_anchor
    // when there is a next or previous line available
    if (fieldType === 'string' || fieldType === 'line_anchor' || fieldType === 'location_anchor') {
        var idx      = typeof state.selectedLineIdx === 'number' ? state.selectedLineIdx : -1;
        var nextLine = idx >= 0 && idx + 1 < PDF_LINES.length ? PDF_LINES[idx + 1].trim() : '';
        var prevLine = idx > 0 ? PDF_LINES[idx - 1].trim() : '';

        if (nextLine) {
            s.push({
                id: 'joinnext', label: 'Join with next line',
                description: 'Appends the line immediately below the matched line. Use when a value spans two rows (e.g. a long address or description).',
                step: { Type: 'join_next_line', Value1: ' ', Value2: null },
                preview: raw.trimEnd() + ' ' + nextLine,
                defaultOn: false, active: false,
            });
        }
        if (prevLine) {
            s.push({
                id: 'joinprev', label: 'Join with previous line',
                description: 'Prepends the line immediately above the matched line. Use when the first part of a value appears on the row before.',
                step: { Type: 'join_prev_line', Value1: ' ', Value2: null },
                preview: prevLine + ' ' + raw.trimStart(),
                defaultOn: false, active: false,
            });
        }
    }

    return s;
}

function rebuildTransforms(suggestions) {
    state.transforms = suggestions
        .filter(function (s) { return s.active && s.step; })
        .map(function (s) { return s.step; });
    updateFinalPreview();
}

function updateFinalPreview() {
    var val = state.extractedValue;

    // Apply transforms client-side for preview
    state.transforms.forEach(function (t) {
        val = applyTransformClient(val, t);
    });
    state.finalValue = val;

    document.getElementById('finalValuePreview').textContent = val || '(empty)';

    var warn = document.getElementById('previewWarning');
    warn.style.display = (state.fieldDef.fieldType === 'date' && val === state.extractedValue && val.match(/\d{1,2}\/\d{1,2}\/\d{2,4}/)) ? '' : 'none';
}

function applyTransformClient(val, step) {
    if (!step || !step.Type) return val;
    switch (step.Type) {
        case 'remove_prefix':
            if (step.Value1 && val.toLowerCase().startsWith(step.Value1.toLowerCase()))
                return val.substring(step.Value1.length).trimStart();
            return val;
        case 'remove_suffix':
            if (step.Value1 && val.toLowerCase().endsWith(step.Value1.toLowerCase()))
                return val.substring(0, val.length - step.Value1.length).trimEnd();
            return val;
        case 'trim':
            return val.trim();
        case 'to_upper': return val.toUpperCase();
        case 'to_lower': return val.toLowerCase();
        case 'replace':
            return step.Value1 ? val.split(step.Value1).join(step.Value2 || '') : val;
        case 'regex_remove':
            if (!step.Value1) return val;
            try { return val.replace(new RegExp(step.Value1, 'gi'), '').trim(); }
            catch (e) { return val; }
        case 'convert_date':
            return tryConvertDate(val) || val;
        case 'join_next_line': {
            var sep = step.Value1 != null ? step.Value1 : ' ';
            var idx = typeof state.selectedLineIdx === 'number' ? state.selectedLineIdx : -1;
            var nxt = idx >= 0 && idx + 1 < PDF_LINES.length ? PDF_LINES[idx + 1].trim() : '';
            return nxt ? val.trimEnd() + sep + nxt : val;
        }
        case 'join_prev_line': {
            var sep2 = step.Value1 != null ? step.Value1 : ' ';
            var idx2 = typeof state.selectedLineIdx === 'number' ? state.selectedLineIdx : -1;
            var prv  = idx2 > 0 ? PDF_LINES[idx2 - 1].trim() : '';
            return prv ? prv + sep2 + val.trimStart() : val;
        }
        default: return val;
    }
}

function tryConvertDate(val) {
    // Try to parse common date formats and return yyyy-MM-dd
    var patterns = [
        { re: /^(\d{1,2})\/(\d{1,2})\/(\d{2})$/, fn: function (m) {
            var y = parseInt(m[3]) < 50 ? 2000 + parseInt(m[3]) : 1900 + parseInt(m[3]);
            return pad(y) + '-' + pad(m[1]) + '-' + pad(m[2]); }},
        { re: /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/, fn: function (m) {
            return pad(m[3]) + '-' + pad(m[1]) + '-' + pad(m[2]); }},
        { re: /^(\d{4})-(\d{2})-(\d{2})$/, fn: function (m) {
            return m[0]; }}, // already formatted
    ];
    // Month-name patterns
    var months = { jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12 };
    var mnRe = /^([A-Za-z]+)\.?\s+(\d{1,2}),?\s+(\d{4})$/;
    var mnM  = val.match(mnRe);
    if (mnM) {
        var mo = months[mnM[1].substring(0,3).toLowerCase()];
        if (mo) return mnM[3] + '-' + pad(mo) + '-' + pad(mnM[2]);
    }
    for (var p of patterns) {
        var m = val.match(p.re);
        if (m) return p.fn(m);
    }
    return null;
}

function pad(n) { return String(n).padStart(2, '0'); }

// ── Line Before Price — Step 3 picker ─────────────────────────────────────────
// Shows the real lines above the trigger from PDF_LINES.
// Multiple lines can be checked and are joined as one charge description.
function renderLineBeforePriceStep3(container) {
    var trigIdx = typeof state.selectedLineIdx === 'number' ? state.selectedLineIdx : -1;

    // Gather up to 6 non-empty lines above the trigger (offset 1 = immediately above)
    var candidates = [];
    if (trigIdx > 0 && PDF_LINES.length > 0) {
        for (var i = trigIdx - 1; i >= 0 && candidates.length < 6; i--) {
            var txt = PDF_LINES[i].trim();
            if (txt.length >= 2) candidates.push({ offset: trigIdx - i, text: txt });
        }
    }

    // ── build HTML ──────────────────────────────────────────────────────────
    var html =
        '<div class="border rounded p-3 bg-light">' +
        '<p class="fw-semibold mb-1 text-primary">↑ Line Before Price rule</p>' +
        '<p class="small text-muted mb-3">' +
        'Tick one or more lines above the trigger to use as the <strong>charge description</strong>. ' +
        'Ticking multiple lines <strong>joins them together</strong>. ' +
        'The last dollar amount on the trigger line becomes the charge amount.' +
        '</p>';

    if (candidates.length === 0) {
        html +=
            '<div class="alert alert-warning small py-2 mb-2">No invoice lines available — auto-detect will be used when the invoice is parsed.</div>' +
            '<div class="form-check mb-1">' +
            '<input class="form-check-input lbp-auto-chk" type="checkbox" id="lbpAuto" checked />' +
            '<label class="form-check-label small fw-semibold" for="lbpAuto">Auto-detect — automatically find the nearest product name above this line</label>' +
            '</div>';
    } else {
        // Lines table: furthest-above at top, trigger at bottom
        html += '<div class="border rounded bg-white mb-2" style="overflow:hidden;">';

        var sorted = candidates.slice().sort(function (a, b) { return b.offset - a.offset; });
        sorted.forEach(function (c, si) {
            var cbId = 'lbpLine_' + si;
            var safeText = c.text.replace(/"/g, '&quot;');
            html +=
                '<div class="d-flex align-items-center gap-2 px-3 py-2 lbp-line-row border-bottom" ' +
                     'data-offset="' + c.offset + '" data-text="' + safeText + '" style="cursor:pointer;">' +
                '<input class="form-check-input lbp-line-chk flex-shrink-0 mt-0" type="checkbox" id="' + cbId + '" style="pointer-events:none;" />' +
                '<label class="form-check-label small font-monospace mb-0 flex-grow-1 user-select-none" for="' + cbId + '" style="cursor:pointer;">' +
                esc(c.text.length > 100 ? c.text.substring(0, 100) + '\u2026' : c.text) +
                '</label>' +
                '</div>';
        });

        // Trigger line (non-selectable)
        var trigText = state.selectedLine.trim();
        html +=
            '<div class="px-3 py-2 d-flex align-items-center gap-2" style="background:#dbeafe;">' +
            '<span class="badge bg-primary flex-shrink-0">trigger</span>' +
            '<span class="small font-monospace fw-semibold text-primary">' +
            esc(trigText.length > 100 ? trigText.substring(0,100)+'\u2026' : trigText) +
            '</span>' +
            '</div>';
        html += '</div>';

        // Auto-detect (separator choice)
        html +=
            '<div class="form-check mb-2" style="cursor:pointer;">' +
            '<input class="form-check-input lbp-auto-chk" type="checkbox" id="lbpAuto" />' +
            '<label class="form-check-label small" for="lbpAuto" style="cursor:pointer;">' +
            '<strong>Auto-detect</strong> — let the system find the nearest product name automatically ' +
            '<span class="text-muted">(best when lines vary between invoices)</span>' +
            '</label></div>';
    }

    // Final value preview
    html +=
        '<div class="mt-1 px-3 py-2 border rounded" style="background:#f0fdf4; min-height:42px;">' +
        '<span class="small text-muted d-block mb-1">Final value that will be captured as charge description:</span>' +
        '<span class="fw-semibold text-success" id="lbpFinalValue" style="font-size:1rem;">(tick a line above)</span>' +
        '</div>' +
        '<p class="text-muted small mt-2 mb-0">No extra transforms needed — just save and the rule takes effect on the next invoice upload.</p>' +
        '</div>';

    container.innerHTML = html;

    // ── refresh logic: called whenever any checkbox changes ──────────────────
    function refresh() {
        var autoChk  = container.querySelector('#lbpAuto');
        var lineChks = Array.from(container.querySelectorAll('.lbp-line-chk'));
        var anyLine  = lineChks.some(function (c) { return c.checked; });
        var preview  = document.getElementById('lbpFinalValue');

        // Highlight selected rows
        container.querySelectorAll('.lbp-line-row').forEach(function (row) {
            var cb = row.querySelector('.lbp-line-chk');
            row.style.background = (cb && cb.checked) ? '#eff6ff' : '';
        });

        if (!anyLine && !(autoChk && autoChk.checked)) {
            // Nothing selected
            document.getElementById('hFieldType').value             = 'line_before_price';
            document.getElementById('hFieldName').value             = 'line_before_price';
            document.getElementById('hDescriptionLineOffset').value = '-1';
            document.getElementById('hTransforms').value            = '';
            if (preview) { preview.textContent = '(tick a line above)'; preview.style.color = '#6c757d'; }
            return;
        }

        if ((autoChk && autoChk.checked) && !anyLine) {
            // Auto mode
            document.getElementById('hFieldType').value             = 'line_before_price';
            document.getElementById('hFieldName').value             = 'line_before_price';
            document.getElementById('hDescriptionLineOffset').value = '-1';
            document.getElementById('hTransforms').value            = '';
            if (preview) { preview.textContent = 'auto-detected from invoice'; preview.style.color = '#198754'; }
            return;
        }

        // One or more specific lines selected — sort by offset descending (top line first)
        var selected = lineChks
            .filter(function (c) { return c.checked; })
            .map(function (c) { return {
                offset: parseInt(c.closest('.lbp-line-row').getAttribute('data-offset')),
                text:   c.closest('.lbp-line-row').getAttribute('data-text')
            }; })
            .sort(function (a, b) { return b.offset - a.offset; });

        var topOffset  = selected[0].offset;
        var joinCount  = selected.length - 1;

        // Build transforms: join_next_line for each additional line + final trim
        var transforms = [];
        for (var j = 0; j < joinCount; j++) {
            transforms.push({ Type: 'join_next_line', Value1: ' ', Value2: null });
        }
        transforms.push({ Type: 'trim', Value1: null, Value2: null });

        document.getElementById('hFieldType').value             = 'table_row';
        document.getElementById('hFieldName').value             = 'charge_desc';
        document.getElementById('hDescriptionLineOffset').value = '-' + topOffset;
        document.getElementById('hTransforms').value            = JSON.stringify(transforms);

        var joined = selected.map(function (s) { return s.text; }).join(' ');
        if (preview) { preview.textContent = joined; preview.style.color = '#198754'; }
    }

    // Wire line row clicks
    container.querySelectorAll('.lbp-line-row').forEach(function (row) {
        row.addEventListener('click', function () {
            var cb = row.querySelector('.lbp-line-chk');
            if (!cb) return;
            cb.checked = !cb.checked;
            // Uncheck auto if any line is now checked
            var autoChk = container.querySelector('#lbpAuto');
            if (cb.checked && autoChk) autoChk.checked = false;
            refresh();
        });
    });

    // Wire auto-detect checkbox
    var autoEl = container.querySelector('#lbpAuto');
    if (autoEl) {
        autoEl.addEventListener('change', function () {
            if (this.checked) {
                // Uncheck all line checkboxes
                container.querySelectorAll('.lbp-line-chk').forEach(function (c) { c.checked = false; });
            }
            refresh();
        });
    }

    // Start with nothing selected (prompt user to tick)
    refresh();
}

document.getElementById('step3Back').addEventListener('click', function () { goTo(2); });

// ═══ SAVE ────────────────────────────────────────────────────────────────────

document.getElementById('saveWizardBtn').addEventListener('click', function () {
    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Saving…';

    var fd = state.fieldDef;

    // Populate hidden form
    // For line_before_price, hFieldName/hFieldType may already have been overridden
    // by the radio picker in renderLineBeforePriceStep3 — only set if not already changed.
    if (fd.fieldType !== 'line_before_price' ||
        document.getElementById('hFieldType').value === '') {
        document.getElementById('hFieldName').value  = fd.fieldName;
        document.getElementById('hFieldType').value  = fd.fieldType;
    }
    document.getElementById('hTargetTable').value   = fd.targetTable;
    document.getElementById('hConditionType').value = state.conditionType;
    document.getElementById('hRegexPattern').value  = state.generatedPattern;
    document.getElementById('hTransforms').value    = state.transforms.length > 0
        ? JSON.stringify(state.transforms) : '';

    // AJAX submit via FormData
    var form  = document.getElementById('wizardForm');
    var token = form.querySelector('[name="__RequestVerificationToken"]').value;
    var body  = new FormData(form);

    fetch('/CarrierRules/QuickCreate', { method: 'POST', body: body })
    .then(function (r) { return r.json(); })
    .then(function (data) {
        var box = document.getElementById('saveResultBox');
        box.style.display = '';
        if (data.success) {
            box.innerHTML =
                '<div class="alert alert-success">' +
                    '<strong>✓ Rule saved!</strong> ' + esc(data.message) +
                    ' <a href="/CarrierRules/Index?carrierId=' + CARRIER_ID + '" class="alert-link ms-2">View all rules →</a>' +
                '</div>';
            document.getElementById('saveWizardBtn').style.display = 'none';
        } else {
            box.innerHTML = '<div class="alert alert-danger">⚠ ' + esc(data.message) + '</div>';
            btn.disabled  = false;
            btn.textContent = '✓ Save Rule';
        }
    })
    .catch(function () {
        document.getElementById('saveResultBox').innerHTML =
            '<div class="alert alert-danger">Save failed — please try again.</div>';
        document.getElementById('saveResultBox').style.display = '';
        btn.disabled = false;
        btn.textContent = '✓ Save Rule';
    });
});

// ── Helpers ──────────────────────────────────────────────────────────────────
function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function escapeRegex(s) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// Init
goTo(1);

})();
</script>
}
