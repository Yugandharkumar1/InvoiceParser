        // ── Tracked-field change: show Configure icon when value is modified or cleared ──
        function injectOrRevealConfigureBtn(input) {
            var label = input.closest('.col-md-4, .col-md-3, .col-md-6')
                            ?.querySelector('label.form-label');
            if (!label) return;

            var ruleField = input.getAttribute('data-rule-field');
            if (!ruleField) return;

            var current  = (input.value || '').trim();
            var original = (input.getAttribute('data-original') || '').trim();
            var isChanged = original !== '' && current !== original;
            var isCleared = original !== '' && current === '';

            if (!isChanged && !isCleared) {
                // Restore: remove any dynamically added Configure btn if value matches original
                var dynBtn = label.querySelector('.btn-create-rule[data-dynamic]');
                if (dynBtn) dynBtn.remove();
                return;
            }

            // Don't duplicate if a button already exists in the label
            if (label.querySelector('.btn-create-rule')) return;

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn-create-rule';
            btn.setAttribute('data-field', ruleField);
            btn.setAttribute('data-dynamic', 'true');
            btn.title = isCleared
                ? 'Value was cleared — add a rule to capture it automatically'
                : 'Value was changed — add a rule to capture the correct value';
            btn.textContent = 'Configure ✎';
            label.appendChild(btn);

            // Also highlight the field to indicate it needs attention
            input.classList.add('field-changed');
        }

        document.querySelectorAll('.tracked-field[data-rule-field]').forEach(function (input) {
            input.addEventListener('change', function () { injectOrRevealConfigureBtn(this); });
            input.addEventListener('input',  function () { injectOrRevealConfigureBtn(this); });
        });

        function populatePdfLines() {
            var container = document.getElementById('pdfLinesContainer');
            container.innerHTML = '';
            if (!_rulePdfText) {
                container.innerHTML = '<em class="text-muted">No invoice text available.</em>';
                return;
            }
            var lines = _rulePdfText.split(/\r?\n/).filter(function (l) { return l.trim().length > 0; });
            lines.forEach(function (line, idx) {
                var div = document.createElement('div');
                div.className = 'pdf-line-item px-2 py-1 rounded cursor-pointer';
                div.textContent = line;
                div.setAttribute('data-line', line);
                div.style.cursor = 'pointer';
                div.style.transition = 'background 0.1s';
                div.addEventListener('click', function () {
                    // Clear previous selection
                    document.querySelectorAll('.pdf-line-item').forEach(function (el) {
                        el.classList.remove('pdf-line-selected');
                        el.style.borderLeft = '';
                        el.style.background = '';
                        el.style.color = '';
                        el.style.fontWeight = '';
                    });
                    // Highlight selected row with a distinct left-border accent
                    div.classList.add('pdf-line-selected');
                    div.style.borderLeft   = '3px solid #0d6efd';
                    div.style.background   = '#dbeafe';
                    div.style.color        = '#1e3a5f';
                    div.style.fontWeight   = '600';
                    div.style.paddingLeft  = '6px';

                    // Scroll into view so it stays visible
                    div.scrollIntoView({ block: 'nearest', behavior: 'smooth' });

                    // Show confirmation banner below the list
                    var banner = document.getElementById('selectedLineBanner');
                    var bannerText = document.getElementById('selectedLineBannerText');
                    var display = line.length > 90 ? line.substring(0, 90) + '…' : line;
                    bannerText.textContent = display;
                    banner.classList.remove('d-none');

                    suggestPattern(line.trim());
                });
                div.addEventListener('mouseenter', function () {
                    if (!div.classList.contains('pdf-line-selected'))
                        div.style.background = '#f0f4ff';
                });
                div.addEventListener('mouseleave', function () {
                    if (!div.classList.contains('pdf-line-selected'))
                        div.style.background = '';
                });
                container.appendChild(div);
            });
        }

        // ── PDF line search / filter ────────────────────────────────────────
        (function () {
            var searchEl  = document.getElementById('pdfLinesSearch');
            var clearBtn  = document.getElementById('pdfLinesSearchClear');
            var noMatchEl = document.getElementById('pdfLinesNoMatch');

            function applyFilter() {
                var term      = searchEl.value.toLowerCase().trim();
                var items     = document.querySelectorAll('#pdfLinesContainer .pdf-line-item');
                var visible   = 0;
                items.forEach(function (el) {
                    var show = !term || el.textContent.toLowerCase().includes(term);
                    el.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                clearBtn.style.display  = term ? '' : 'none';
                noMatchEl.style.display = (term && visible === 0) ? '' : 'none';
            }

            searchEl.addEventListener('input', applyFilter);

            clearBtn.addEventListener('click', function () {
                searchEl.value = '';
                applyFilter();
                searchEl.focus();
            });
        })();

        // ── Builder helpers ───────────────────────────────────────────────────

        function showBuilderForConditionType(ct) {
            var isFriendly = ct === 'regex_match';
            document.getElementById('ruleFriendlyBuilder').style.display   = isFriendly ? '' : 'none';
            document.getElementById('ruleSimpleBuilder').style.display     = isFriendly ? 'none' : '';
            document.getElementById('ruleSimpleModeWarning').style.display = isFriendly ? 'none' : '';
            if (!isFriendly) {
                var hints = {
                    starts_with: 'The parser will find lines that <strong>start with</strong> this text (case-insensitive).',
                    contains:    'The parser will find lines that <strong>contain</strong> this text (case-insensitive).',
                    equals:      'The parser will find lines that are <strong>exactly</strong> this text (case-insensitive).',
                };
                document.getElementById('rulePatternLabel').textContent = 'Match Value';
                document.getElementById('rulePatternHint').innerHTML    = hints[ct] || '';
            }
        }

        // Detects date-like content in the prefix (month names, 4-digit years, date separators)
        var DATE_IN_PREFIX = [
            /\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/i,
            /\b\d{4}\b/,
            /\d{1,2}\/\d{1,2}\/\d{2,4}/,
            /\d{1,2}-\d{1,2}-\d{2,4}/,
        ];

        function buildFriendlyPattern() {
            var prefix  = document.getElementById('rulePrefix').value.trim();
            var example = document.getElementById('ruleCaptureExample').value.trim();
            var pattern = '';

            // ── Choose the right capture group ───────────────────────────────
            // The backend applies regex with Singleline mode, where "." matches newlines.
            // Using (.+) would greedily consume the rest of the entire document.
            // • (\S+)        — for single-token values (account numbers, invoice numbers, codes)
            // • ([^\r\n]+)   — for values that may contain spaces but must not cross a line boundary
            var captureGroup = (example && example.indexOf(' ') >= 0) ? '([^\\r\\n]+)' : '(\\S+)';

            if (prefix) {
                var escaped = prefix.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                // Collapse whitespace sequences so minor spacing differences are tolerated
                escaped = escaped.replace(/(?:\\ |\s)+/g, '\\s+');
                pattern = escaped + '\\s+' + captureGroup;
            } else if (example) {
                // No prefix — capture the exact value wherever it appears on a line
                pattern = '(' + example.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')';
            }
            document.getElementById('rulePattern').value = pattern;

            // ── Date-in-prefix warning ────────────────────────────────────────
            var dateWarn = document.getElementById('ruleDatePrefixWarning');
            if (dateWarn) {
                var hasDate = prefix && DATE_IN_PREFIX.some(function (re) { return re.test(prefix); });
                dateWarn.style.display = hasDate ? '' : 'none';
            }

            // ── Update the preview sentence ───────────────────────────────────
            var preview = document.getElementById('ruleFriendlyPreview');
            var previewSpan = document.getElementById('previewPrefixText');
            if (prefix && example) {
                previewSpan.innerHTML = 'Find lines containing <strong>"' + escHtml(prefix) + '"</strong> and capture the value that follows — currently <strong class="text-success">"' + escHtml(example) + '"</strong>.';
                preview.style.display = '';
            } else if (!prefix && example) {
                previewSpan.innerHTML = 'Find any line that contains <strong class="text-success">"' + escHtml(example) + '"</strong> and capture it as the value.';
                preview.style.display = '';
            } else {
                preview.style.display = 'none';
            }
        }

        function escHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // ── Token picker: renders the selected line as clickable word-badges ──
        // Supports range selection: click first word, then click another word to
        // extend the selection across all tokens in between (e.g. "March 1, 2026").
        function renderLineTokens(line) {
            var wrap      = document.getElementById('ruleTokenPickerWrap');
            var container = document.getElementById('ruleLineTokens');
            var hintEl    = document.getElementById('ruleTokenHint');
            container.innerHTML = '';
            var tokens = line.trim().split(/\s+/);
            if (tokens.length < 2) { wrap.style.display = 'none'; return; }

            var rangeStart = -1;   // index of first clicked token (-1 = none)
            var spans = [];

            function applyHighlight(from, to) {
                var lo = Math.min(from, to), hi = Math.max(from, to);
                spans.forEach(function (s, i) {
                    var inRange = (i >= lo && i <= hi);
                    s.dataset.selected = inRange ? '1' : '';
                    s.style.background = inRange ? '#0d6efd' : '#fff';
                    s.style.color      = inRange ? '#fff'    : '#333';
                    s.style.fontWeight = inRange ? '600'     : '400';
                });
                // prefix = everything before the first selected token
                var prefix  = tokens.slice(0, lo).join(' ');
                var example = tokens.slice(lo, hi + 1).join(' ');
                document.getElementById('rulePrefix').value         = prefix;
                document.getElementById('ruleCaptureExample').value = example;
                buildFriendlyPattern();
            }

            tokens.forEach(function (tok, idx) {
                var span = document.createElement('span');
                span.textContent = tok;
                span.className = 'badge border me-1 mb-1';
                span.style.cssText = 'cursor:pointer;font-size:0.82rem;font-weight:400;background:#fff;color:#333;transition:background .1s;';
                span.title = 'Click to select "' + tok + '"; click a second word to extend selection';

                span.addEventListener('mouseenter', function () {
                    if (!span.dataset.selected) span.style.background = '#e7f0ff';
                    // Preview the range while hovering if a start is already set
                    if (rangeStart >= 0 && rangeStart !== idx) {
                        var lo = Math.min(rangeStart, idx), hi = Math.max(rangeStart, idx);
                        spans.forEach(function (s, i) {
                            if (!s.dataset.selected) {
                                s.style.background = (i >= lo && i <= hi) ? '#cfe2ff' : '#fff';
                            }
                        });
                    }
                });
                span.addEventListener('mouseleave', function () {
                    if (!span.dataset.selected) span.style.background = '#fff';
                    // Clear hover-preview on non-selected spans
                    if (rangeStart >= 0) {
                        spans.forEach(function (s) {
                            if (!s.dataset.selected) s.style.background = '#fff';
                        });
                    }
                });
                span.addEventListener('click', function () {
                    if (rangeStart === -1) {
                        // First click — set range start, highlight single token
                        rangeStart = idx;
                        applyHighlight(idx, idx);
                        if (hintEl) hintEl.innerHTML =
                            '<strong>First word selected.</strong> Now click another word to extend the selection, or click the same word again to confirm.';
                    } else if (rangeStart === idx) {
                        // Clicked the same token again — confirm single selection, reset
                        rangeStart = -1;
                        applyHighlight(idx, idx);
                        if (hintEl) hintEl.innerHTML =
                            '<strong>Click once</strong> to select a single word. ' +
                            '<strong>Click a second word</strong> to extend the selection (e.g. a full date like <em>March 1, 2026</em>).';
                    } else {
                        // Second click — extend selection to cover the range
                        applyHighlight(rangeStart, idx);
                        rangeStart = -1;
                        if (hintEl) hintEl.innerHTML =
                            '<strong>Click once</strong> to select a single word. ' +
                            '<strong>Click a second word</strong> to extend the selection (e.g. a full date like <em>March 1, 2026</em>).';
                    }
                });
                container.appendChild(span);
                spans.push(span);
            });

            wrap.style.display = '';
        }

        function suggestPattern(line) {
            var ct = document.getElementById('ruleConditionType').value;
            if (ct === 'regex_match') {
                renderLineTokens(line);
                // Auto-select the last token as a starting suggestion
                var tokens = line.trim().split(/\s+/);
                var lastIdx = tokens.length - 1;
                var prefix  = tokens.slice(0, lastIdx).join(' ');
                var example = tokens[lastIdx] || '';
                document.getElementById('rulePrefix').value         = prefix;
                document.getElementById('ruleCaptureExample').value = example;
                buildFriendlyPattern();
                // Visually pre-select the last token badge (direct style, no range-start side-effect)
                var badges = document.querySelectorAll('#ruleLineTokens span');
                badges.forEach(function (b, bi) {
                    var isLast = (bi === badges.length - 1);
                    b.dataset.selected = isLast ? '1' : '';
                    b.style.background = isLast ? '#0d6efd' : '#fff';
                    b.style.color      = isLast ? '#fff'    : '#333';
                    b.style.fontWeight = isLast ? '600'     : '400';
                });
            } else {
                // Simple modes: the plain line text IS the match value
                document.getElementById('rulePatternSimple').value = line;
                document.getElementById('rulePattern').value       = line;
            }
        }

        document.getElementById('rulePrefix').addEventListener('input', buildFriendlyPattern);
        document.getElementById('ruleCaptureExample').addEventListener('input', buildFriendlyPattern);

        document.getElementById('ruleClearPrefix').addEventListener('click', function () {
            document.getElementById('rulePrefix').value = '';
            buildFriendlyPattern();
        });

        // Sync simple builder → rulePattern
        document.getElementById('rulePatternSimple').addEventListener('input', function () {
            document.getElementById('rulePattern').value = this.value;
        });

        document.getElementById('ruleConditionType').addEventListener('change', function () {
            showBuilderForConditionType(this.value);
            var selected = document.querySelector('#pdfLinesContainer .pdf-line-item.pdf-line-selected');
            if (selected) suggestPattern(selected.getAttribute('data-line') || selected.textContent);
        });

        // Advanced toggle
        document.getElementById('toggleAdvancedPattern').addEventListener('click', function () {
            var panel = document.getElementById('advancedPatternPanel');
            var showing = panel.style.display !== 'none';
            panel.style.display = showing ? 'none' : '';
            this.textContent = showing ? '⚙ Advanced — show raw pattern' : '⚙ Advanced — hide raw pattern';
        });

        // Returns the correct pattern regardless of which builder is active
        function getActivePattern() {
            var ct = document.getElementById('ruleConditionType').value;
            if (ct !== 'regex_match') {
                return document.getElementById('rulePatternSimple').value.trim();
            }
            return document.getElementById('rulePattern').value.trim();
        }

        document.getElementById('ruleTestBtn').addEventListener('click', function () {
            var btn = this;
            btn.disabled = true;
            var pattern = getActivePattern();
            if (!pattern) {
                alert('Please click a line above first, or enter a value.');
                btn.disabled = false;
                return;
            }
            var payload = {
                carrierId:      _ruleCarrierId,
                pdfText:        _rulePdfText,
                conditionType:  document.getElementById('ruleConditionType').value,
                regexPattern:   pattern
            };
            fetch('/CarrierRules/Test', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var box = document.getElementById('ruleTestResultBox');
                box.style.display = '';
                if (data.success) {
                    box.innerHTML = '<div class="alert alert-success py-2 mb-0">✓ Matched: '
                        + data.matches.map(function (m) { return '<code>' + m + '</code>'; }).join(', ')
                        + '</div>';
                } else {
                    box.innerHTML = '<div class="alert alert-warning py-2 mb-0">⚠ ' + data.message + '</div>';
                }
            })
            .catch(function () {
                document.getElementById('ruleTestResultBox').innerHTML =
                    '<div class="alert alert-danger py-2 mb-0">Request failed.</div>';
                document.getElementById('ruleTestResultBox').style.display = '';
            })
            .finally(function () { btn.disabled = false; });
        });

        // ── Re-parse helpers ──────────────────────────────────────────────────
        function showReparseBanner(type, msg) {
            var banner = document.getElementById('reparseBanner');
            var icon   = document.getElementById('reparseBannerIcon');
            var msgEl  = document.getElementById('reparseBannerMsg');
            banner.className = 'alert d-flex align-items-center gap-2 mb-3 alert-' + type;
            icon.textContent  = type === 'success' ? '✓' : type === 'danger' ? '✗' : '⟳';
            msgEl.innerHTML   = msg;
            banner.style.removeProperty('display');
            banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function buildChargeRow(charge, idx) {
            var desc = (charge.description || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
            var amt  = charge.amount  || '';
            var line = (charge.line     || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
            var loc  = (charge.location || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
            return '<tr data-auto="true" data-orig-desc="' + desc + '" data-orig-amt="' + amt + '">'
                + '<td class="text-center align-middle row-number">' + (idx + 1) + '</td>'
                + '<td class="text-center align-middle"><span class="badge bg-success badge-status" title="Auto-detected">Auto</span></td>'
                + '<td><input name="Charges[' + idx + '].ChargeDescription" value="' + desc + '" class="form-control form-control-sm charge-desc" /></td>'
                + '<td><div class="input-group input-group-sm"><span class="input-group-text">$</span>'
                + '<input name="Charges[' + idx + '].Amount" value="' + amt + '" type="number" step="0.01" class="form-control form-control-sm charge-amount" /></div></td>'
                + '<td><input name="Charges[' + idx + '].Line" value="' + line + '" class="form-control form-control-sm" /></td>'
                + '<td><input name="Charges[' + idx + '].Location" value="' + loc + '" class="form-control form-control-sm" /></td>'
                + '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row">X</button></td>'
                + '</tr>';
        }

        function applyReparseResults(data) {
            var tbody = document.getElementById('chargesTableBody');
            tbody.innerHTML = data.charges.map(function (c, i) { return buildChargeRow(c, i); }).join('');

            var countBadge = document.querySelector('#chargesPane .badge-status');
            if (countBadge) {
                countBadge.className = data.chargeCount > 0
                    ? 'badge bg-success badge-status ms-2'
                    : 'badge bg-secondary badge-status ms-2';
                countBadge.textContent = data.chargeCount + ' Auto';
            }

            var s = data.summary;
            function setInput(name, val) {
                var el = document.querySelector('[name="' + name + '"]');
                if (el && val != null) el.value = val;
            }
            setInput('InvoiceNumber',       s.invoiceNumber);
            setInput('CarrierAccount',      s.carrierAccount);
            setInput('InvoiceDate',         s.invoiceDate);
            setInput('InvoiceStartDate',    s.invoiceStartDate);
            setInput('InvoiceEndDate',      s.invoiceEndDate);
            setInput('InvoiceDueDate',      s.invoiceDueDate);
            setInput('BeginningBalance',    s.beginningBalance);
            setInput('Payment',             s.payment);
            setInput('PreviousAdjustments', s.previousAdjustments);
            setInput('CurrentAdjustments',  s.currentAdjustments);
            setInput('CurrentCharges',      s.currentCharges);
            setInput('CurrentTax',          s.currentTax);
            setInput('EndingBalance',       s.endingBalance);

            if (typeof updateTotal === 'function') updateTotal();
            if (typeof applySearchAndFilters === 'function') applySearchAndFilters();
            if (typeof renderPage === 'function') renderPage();

            showReparseBanner('success',
                '<strong>Invoice re-parsed</strong> — found <strong>' + data.chargeCount + '</strong> charge(s) using the latest rules.'
                + ' <a href="/CarrierRules/Index/' + _ruleCarrierId + '" class="alert-link ms-2">View all rules →</a>');
        }

        function reparseInvoice() {
            var pdfText = (document.querySelector('[name="PdfText"]') || {}).value || '';
            if (!pdfText) {
                showReparseBanner('warning', 'No PDF text stored — please re-upload the invoice to refresh results.');
                return;
            }
            var btn = document.getElementById('reparseBtn');
            if (btn) { btn.disabled = true; btn.textContent = '⟳ Parsing…'; }
            showReparseBanner('info', '<span class="spinner-border spinner-border-sm me-2"></span> Re-parsing invoice with the latest rules…');

            var token = document.querySelector('[name="__RequestVerificationToken"]').value;
            var form  = new FormData();
            form.append('__RequestVerificationToken', token);
            form.append('carrierId', _ruleCarrierId);
            form.append('pdfText',   pdfText);

            fetch('/api/invoice/reparse', { method: 'POST', body: form })
            .then(function (r) {
                if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Server error ' + r.status); });
                return r.json();
            })
            .then(function (data) { applyReparseResults(data); })
            .catch(function (err) {
                showReparseBanner('danger', 'Re-parse failed: ' + err.message + '. Please refresh the page and try again.');
            })
            .finally(function () {
                if (btn) { btn.disabled = false; btn.textContent = '🔄 Re-parse'; }
            });
        }

        document.getElementById('reparseBtn').addEventListener('click', reparseInvoice);

        document.getElementById('saveRuleBtn').addEventListener('click', function () {
            var btn = this;
            var pattern = getActivePattern();
            if (!pattern) { alert('Please click a line above first, or enter a value.'); return; }

            btn.disabled = true;
            var token = document.querySelector('[name="__RequestVerificationToken"]').value;
            var form = new FormData();
            form.append('__RequestVerificationToken', token);
            form.append('CarrierId',     _ruleCarrierId);
            form.append('FieldName',     _ruleFieldName);
            form.append('RegexPattern',  pattern);
            form.append('ConditionType', document.getElementById('ruleConditionType').value);
            form.append('ConditionSource', 'line_text');
            form.append('TargetTable',   't_invoice');
            form.append('FieldType',     'string');
            form.append('SortOrder',     '10');
            form.append('IsActive',      'true');

            // If "Store as negative" is checked, add a negate_amount transform
            var negChk = document.getElementById('negateAmountChk');
            if (negChk && negChk.checked) {
                form.append('TransformationsJson', JSON.stringify([{ type: 'negate_amount' }]));
            }

            fetch('/CarrierRules/QuickCreate', { method: 'POST', body: form })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    _ruleModal.hide();
                    reparseInvoice();   // automatically re-parse with the new rule
                } else {
                    alert('Could not save: ' + data.message);
                }
            })
            .catch(function () { alert('Save failed. Please try again.'); })
            .finally(function () { btn.disabled = false; });
        });
        // ── End Create Rule from This ──────────────────────────────────────

        // Sync main form field values to feedback form hidden inputs before feedback submit
        document.getElementById('feedbackForm').addEventListener('submit', function () {
            var mainForm = document.querySelector('form[action*="Save"]');
            var feedbackForm = this;
            var fieldsToSync = [
                'InvoiceNumber', 'CarrierAccount', 'InvoiceDate', 'InvoiceStartDate',
                'InvoiceEndDate', 'InvoiceDueDate', 'BeginningBalance', 'Payment',
                'PreviousAdjustments', 'CurrentAdjustments', 'CurrentCharges',
                'CurrentTax', 'EndingBalance'
            ];
            fieldsToSync.forEach(function (field) {
                var src = mainForm.querySelector('[name="' + field + '"]');
                var dst = feedbackForm.querySelector('[name="' + field + '"]');
                if (src && dst) dst.value = src.value;
            });

            showLoadingOverlay('Please wait... we are saving your feedback to help us improve.');
        });

        // ── Collect intentionally-cleared summary fields ─────────────────────────
        // Called just before the Save form submits. Detects summary fields that had
        // an auto-detected value (data-original != '') but are now empty, meaning the
        // user deliberately removed the value and wants it skipped on future invoices.
        function collectSkippedFields() {
            // Map from model property name to a friendly label (used for logging only)
            var summaryInputs = [
                'BeginningBalance', 'Payment', 'PreviousAdjustments',
                'CurrentAdjustments', 'CurrentCharges', 'CurrentTax', 'EndingBalance',
                'InvoiceNumber', 'CarrierAccount', 'InvoiceDate',
                'InvoiceStartDate', 'InvoiceEndDate', 'InvoiceDueDate'
            ];

            var skipped = [];
            summaryInputs.forEach(function (name) {
                var input = document.querySelector('[name="' + name + '"]');
                if (!input) return;
                var original = (input.getAttribute('data-original') || '').trim();
                var current  = input.value.trim();
                // Field had a value but user cleared it → mark as intentionally skipped
                if (original !== '' && current === '') {
                    skipped.push(name);
                }
            });

            document.getElementById('hSkippedSummaryFields').value = skipped.join(',');
        }
    </script>
}
